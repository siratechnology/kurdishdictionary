# Copy this file to .env and fill in the values
SQL_SA_PASSWORD=YourStrong@Passw0rd
SQL_USER_PASSWORD=YourAppUserPassword

# JWT signing key for the admin dashboard login.
# MUST be set: the backend refuses to start in Production without it, because a shipped default key
# would let anyone forge an admin token. Rotating it signs every user out.
# Generate one with:  openssl rand -base64 48
JWT_KEY=ChangeMeToA64CharRandomStringGeneratedWithOpensslRandBase64

# Telerik UI for Blazor licence account. Consumed as docker-compose build args by the
# frontend-blazor image; the package is not on nuget.org, so `docker compose build` fails
# with NU1101 without them. Build-stage only — no credential reaches the runtime image.
TELERIK_USER=you@example.com
TELERIK_PASS=your-telerik-password

# Where uploaded files land on the HOST — bind-mounted into the backend at /uploads.
# The directory must already exist or the backend starts with an unwritable mount and every
# avatar upload fails:  mkdir -p /root/uploads/jinzar
UPLOAD_ROOT=/root/uploads/jinzar

# Public origin of the Next.js site. Passed to the container as NEXT_PUBLIC_BASE_URL.
NEXT_PUBLIC_BASE_URL=https://jinzar.krd

# Seeded accounts, created on first run only. Change these passwords after logging in.
SEED_ADMIN_USER=sirwan
SEED_ADMIN_EMAIL=sirwanjaff999@gmail.com
SEED_ADMIN_PASSWORD=Admin@123!
SEED_EDITOR_PASSWORD=Editor@123!

# Shared secret for machine-to-machine calls between the web tier and the API — currently the
# 60-second presence flush. Any long random string; both containers must read the same value.
# Unset, the flush returns silently: presence still works live from memory, but «دوایین جار»
# does not survive a restart and UserPresences stays empty.
INTERNAL_API_KEY=change-me-to-a-long-random-string

@* Moved off /taxonomy, which is now the schema tree. Nothing here changed — this is the
   membership manager (which words are in which پۆل, which carry which جۆری وشە) and it is
   still the only screen that does that job. *@
@page "/taxonomy/manage"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin,Editor")]
@inject WordService WordSvc
@inject Toast Toast

<PageTitle>پۆل و جۆرەکانی وشە</PageTitle>

@* Membership management: pick a class on the start side, manage its words on the other.

   The left list used to hand-roll everything a grid already does — an inline rename state, an
   inline "are you sure" state, a create row, a hover-reveal button pair — about 120 lines of
   markup that could each be in the wrong state at the same time. It is a TelerikGrid with
   inline editing now, and all four of those states belong to the grid.

   The right side is not a grid and should not be one: adding fifteen words to a category is a
   search-and-pick gesture, and the only thing that made it awkward was the hand-built
   typeahead. That is a TelerikMultiSelect reading from the server. *@

<TelerikScope>

<PageHeader Title="پۆل و جۆرەکانی وشە"
            Subtitle="بەڕێوەبردنی پۆلەکان و جۆرەکانی وشە و وشە پەیوەستەکانیان" />

<div class="tab-rail mb-4">
    <button type="button" @onclick="() => SwitchTab(Tab.Categories)"
            class="tab-pill @(_tab == Tab.Categories ? "is-active" : "")">
        پۆلەکان <bdi class="text-11">(@Ku.N(_categories.Count))</bdi>
    </button>
    <button type="button" @onclick="() => SwitchTab(Tab.SpeechPanes)"
            class="tab-pill @(_tab == Tab.SpeechPanes ? "is-active" : "")">
        جۆرەکانی وشە <bdi class="text-11">(@Ku.N(_speechStats.Count))</bdi>
    </button>
</div>

<div class="flex flex-col gap-4 lg:flex-row" style="min-height: 560px;">

    @* ── START SIDE: the class list ─────────────────────────────────────── *@
    <div class="flex w-full shrink-0 flex-col gap-3 lg:w-96">

        @if (_tab == Tab.Categories)
        {
            @* Add sits above the grid rather than inside its toolbar: creating a category is one
               field, and a grid's own "add" row makes you fill a table to type one word. *@
            <div class="flex gap-2">
                <input @bind="_newCatName" @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await CreateCategory(); })"
                       placeholder="ناوی پۆلی نوێ…"
                       class="field flex-1" />
                <TelerikButton OnClick="@CreateCategory"
                               Enabled="@(!string.IsNullOrWhiteSpace(_newCatName) && !_catSaving)"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Icon="@SvgIcon.Plus">
                    @(_catSaving ? "…" : "زیادکردن")
                </TelerikButton>
            </div>

            <TelerikGrid Data="@_categories" EditMode="@GridEditMode.Inline" Height="520px"
                         Sortable="true" SelectionMode="@GridSelectionMode.Single"
                         SelectedItems="@_selectedCats"
                         SelectedItemsChanged="@(async (IEnumerable<CategoryDto> items) => await OnCategorySelected(items))"
                         OnUpdate="@RenameCategory" OnDelete="@DeleteCategory">
                <GridColumns>
                    <GridColumn Field="@nameof(CategoryDto.Name)" Title="پۆل" />

                    @* Usage count on every row. پڕۆمپت ١١ wants this visible everywhere: once you
                       can see that most categories hold two or three words, the sprawl becomes
                       self-correcting. Sorted ascending, the long tail is the first thing you see. *@
                    <GridColumn Field="@nameof(CategoryDto.WordCount)" Title="وشە" Width="110px" Editable="false">
                        <Template>
                            @{ var c = (CategoryDto)context; }
                            <span class="pill @(c.WordCount > 0 ? "pill-ok" : "pill-muted")">
                                <bdi>@Ku.N(c.WordCount)</bdi>
                            </span>
                        </Template>
                    </GridColumn>

                    <GridCommandColumn Width="120px">
                        <GridCommandButton Command="Edit" Icon="@SvgIcon.Pencil" Title="گۆڕینی ناو" />
                        <GridCommandButton Command="Save" Icon="@SvgIcon.Check" ShowInEdit="true" Title="پاشەکەوت" />
                        <GridCommandButton Command="Cancel" Icon="@SvgIcon.Cancel" ShowInEdit="true" Title="پاشگەز" />
                        <GridCommandButton Command="Delete" Icon="@SvgIcon.Trash"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error" Title="سڕینەوە" />
                    </GridCommandColumn>
                </GridColumns>

                <NoDataTemplate>
                    <div class="flex flex-col items-center gap-2 py-12 text-center">
                        <span class="hatch h-10 w-10 rounded-full border border-line"></span>
                        <p class="text-sm text-ink-1">هێشتا هیچ پۆلێک نییە</p>
                        <p class="text-xs text-ink-3">لە سەرەوە پۆلی نوێ زیاد بکە</p>
                    </div>
                </NoDataTemplate>
            </TelerikGrid>
        }
        else
        {
            <div class="flex items-center gap-2 rounded-chip border border-line bg-page px-3 py-2.5 text-xs text-ink-2">
                <Icon Name="alert" Class="h-3.5 w-3.5 shrink-0" />
                جۆرەکانی وشە نەگۆڕن — تەنها وشەکانیان بەڕێوە ببە
            </div>

            <TelerikGrid Data="@_speechStats" Height="520px" Sortable="true"
                         SelectionMode="@GridSelectionMode.Single"
                         SelectedItems="@_selectedPanes"
                         SelectedItemsChanged="@(async (IEnumerable<SpeechPaneStatDto> items) => await OnSpeechPaneSelected(items))">
                <GridColumns>
                    <GridColumn Field="@nameof(SpeechPaneStatDto.Kurdish)" Title="جۆری وشە" />
                    <GridColumn Field="@nameof(SpeechPaneStatDto.WordCount)" Title="وشە" Width="110px">
                        <Template>
                            @{ var s = (SpeechPaneStatDto)context; }
                            <span class="pill @(s.WordCount > 0 ? "pill-ok" : "pill-muted")">
                                <bdi>@Ku.N(s.WordCount)</bdi>
                            </span>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
        }
    </div>

    @* ── END SIDE: the words in the selected class ──────────────────────── *@
    <div class="flex min-w-0 flex-1 flex-col gap-4">

        @if (!HasSelection)
        {
            <div class="flex flex-1 flex-col items-center justify-center gap-4 rounded-card border border-dashed border-line bg-card p-8 text-center">
                <span class="hatch h-14 w-14 rounded-card border border-line"></span>
                <div>
                    <p class="text-base font-medium text-ink-1">@(_tab == Tab.Categories ? "پۆلێک هەڵبژێرە" : "جۆرێک هەڵبژێرە")</p>
                    <p class="mt-1.5 text-sm leading-relaxed text-ink-2">
                        لە لیستەکەوە دانەیەک هەڵبژێرە<br />بۆ بینین و بەڕێوەبردنی وشەکانی
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="card flex items-center gap-3 px-5 py-4">
                <span class="card-badge !h-10 !w-10">
                    <Icon Name="@(_tab == Tab.Categories ? "tag" : "book")" Class="h-5 w-5" />
                </span>
                <div class="min-w-0">
                    <span class="block truncate text-20 font-medium leading-tight text-ink-1">@SelectionName</span>
                    <span class="text-xs text-ink-2">@(_tab == Tab.Categories ? "پۆل" : "جۆری وشە")</span>
                </div>
                <span class="pill pill-muted ms-auto shrink-0">
                    <bdi>@Ku.N(_membersTotal)</bdi> وشە
                </span>
            </div>

            @* ── Add words ── *@
            <div class="card">
                <div class="mb-3 flex items-center gap-2.5">
                    <span class="card-badge"><Icon Name="plus" Class="h-4 w-4" /></span>
                    <h2 class="card-title">زیادکردنی وشە</h2>
                </div>

                <div class="flex flex-col gap-3 sm:flex-row">
                    @* Reads from the server as you type. The list is filtered to words that are
                       not already in this class — offering a word you cannot add is the fastest
                       way to make people distrust the box. *@
                    <TelerikMultiSelect Data="@_wordOptions" @bind-Value="@_pickedIds"
                                        TextField="@nameof(WordDto.Kurdish)" ValueField="@nameof(WordDto.Id)"
                                        Filterable="true" OnRead="@OnWordSearch"
                                        MinLength="1" Placeholder="وشە بگەڕێ و هەڵبژێرە…"
                                        Class="flex-1" Width="100%" />

                    <TelerikButton OnClick="@AddPickedWords"
                                   Enabled="@(_pickedIds.Count > 0 && !_saving)"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">
                        @(_saving ? "پاشەکەوت دەکرێت…" : $"زیادکردنی {Ku.N(_pickedIds.Count)} وشە")
                    </TelerikButton>
                </div>
            </div>

            @* ── Member words ── *@
            <div class="card flex min-h-0 flex-1 flex-col">
                <div class="mb-3 flex items-center gap-3">
                    <span class="card-badge"><Icon Name="book" Class="h-4 w-4" /></span>
                    <h2 class="card-title">وشەکان</h2>
                    <div class="relative ms-auto w-56">
                        <span class="pointer-events-none absolute end-3 top-1/2 -translate-y-1/2 text-ink-3">
                            <Icon Name="search" Class="h-3.5 w-3.5" />
                        </span>
                        <input value="@_memberSearch" @oninput="OnMemberSearch"
                               placeholder="گەڕان لەناو وشەکان…"
                               class="field py-1.5 pe-9 text-xs" />
                    </div>
                </div>

                @if (_membersLoading)
                {
                    <div class="flex flex-wrap gap-2">
                        @for (int i = 0; i < 12; i++)
                        {
                            <div class="skeleton h-8 w-24 rounded-full"></div>
                        }
                    </div>
                }
                else if (!_members.Any())
                {
                    <div class="py-10 text-center">
                        <p class="text-sm text-ink-2">
                            @(string.IsNullOrWhiteSpace(_memberSearch) ? "هێشتا هیچ وشەیەک زیادنەکراوە" : "هیچ وشەیەک نەدۆزرایەوە")
                        </p>
                        @if (string.IsNullOrWhiteSpace(_memberSearch))
                        {
                            <p class="mt-1 text-xs text-ink-3">لە سەرەوە وشە زیاد بکە</p>
                        }
                    </div>
                }
                else
                {
                    <div class="flex flex-wrap gap-2">
                        @foreach (var w in _members)
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-card py-1.5 pe-3 ps-1.5 text-sm text-ink-1">
                                <button @onclick="() => RemoveMember(w)" disabled="@_saving" title="لابردن"
                                        class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-ink-3 transition-colors hover:bg-danger-tint hover:text-danger disabled:opacity-40">
                                    <Icon Name="close" Class="h-2.5 w-2.5" />
                                </button>
                                @w.Kurdish
                            </span>
                        }
                    </div>

                    @if (_membersHasMore)
                    {
                        <button @onclick="LoadMoreMembers" disabled="@_membersLoadingMore"
                                class="mt-4 w-full rounded-chip border border-dashed border-line py-2.5 text-xs text-ink-2 transition-colors hover:bg-page disabled:opacity-40">
                            @(_membersLoadingMore ? "بارکردن…" : "+ وشەی زیاتر")
                        </button>
                    }
                }
            </div>
        }
    </div>
</div>

</TelerikScope>

@code {
    enum Tab { Categories, SpeechPanes }
    Tab _tab = Tab.Categories;

    // ── Class lists ─────────────────────────────────────────────────────────
    List<CategoryDto> _categories = new();
    List<SpeechPaneStatDto> _speechStats = new();

    bool _catSaving;
    string _newCatName = "";

    // ── Selection ───────────────────────────────────────────────────────────
    // Telerik drives selection through a collection even in Single mode, so these hold at most one.
    IEnumerable<CategoryDto> _selectedCats = Enumerable.Empty<CategoryDto>();
    IEnumerable<SpeechPaneStatDto> _selectedPanes = Enumerable.Empty<SpeechPaneStatDto>();

    int? _selectedCatId;
    int? _selectedSpeechId;

    bool HasSelection => _tab == Tab.Categories ? _selectedCatId is not null : _selectedSpeechId is not null;

    string SelectionName => _tab == Tab.Categories
        ? _categories.FirstOrDefault(c => c.Id == _selectedCatId)?.Name ?? ""
        : _speechStats.FirstOrDefault(s => s.Id == _selectedSpeechId)?.Kurdish ?? "";

    // ── Member words ────────────────────────────────────────────────────────
    List<WordDto> _members = new();
    int _membersTotal;
    string _memberSearch = "";
    bool _membersLoading;
    bool _membersLoadingMore;
    bool _membersHasMore;
    int _membersPage = 1;
    const int MembersPageSize = 40;
    CancellationTokenSource? _memberCts;

    // ── Add-words picker ────────────────────────────────────────────────────
    List<WordDto> _wordOptions = new();
    List<int> _pickedIds = new();

    bool _saving;

    // ═══════════════════════════════════════════════════════════════════════
    protected override async Task OnInitializedAsync()
    {
        var catsTask = WordSvc.GetCategoriesAsync();
        var statsTask = WordSvc.GetSpeechTypeStatsAsync();

        try
        {
            _categories = await catsTask;
            _speechStats = await statsTask;
        }
        catch (Exception ex)
        {
            Toast.Error($"لیستەکان نەهاتنەوە: {ex.Message}");
        }
    }

    void SwitchTab(Tab tab)
    {
        if (_tab == tab) return;
        _tab = tab;
        ClearSelection();
    }

    void ClearSelection()
    {
        _selectedCats = Enumerable.Empty<CategoryDto>();
        _selectedPanes = Enumerable.Empty<SpeechPaneStatDto>();
        _selectedCatId = null;
        _selectedSpeechId = null;
        ResetRightPanel();
    }

    void ResetRightPanel()
    {
        _members = new();
        _membersTotal = 0;
        _memberSearch = "";
        _membersHasMore = false;
        _pickedIds = new();
        _wordOptions = new();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Category CRUD
    // ═══════════════════════════════════════════════════════════════════════
    async Task CreateCategory()
    {
        if (string.IsNullOrWhiteSpace(_newCatName) || _catSaving) return;

        var name = _newCatName.Trim();
        _catSaving = true;
        try
        {
            var created = await WordSvc.CreateCategoryAsync(name);
            if (created is not null && !_categories.Any(c => c.Id == created.Id))
            {
                _categories.Add(created);
                _categories = _categories.OrderBy(c => c.Name).ToList();
            }
            _newCatName = "";
            Toast.Success($"پۆلی «{name}» زیادکرا");
        }
        catch (Exception ex)
        {
            Toast.Error($"زیادکردنی پۆل سەرکەوتوو نەبوو: {ex.Message}");
        }
        finally { _catSaving = false; }
    }

    /// <summary>
    /// Inline rename. The grid hands us a COPY of the row, so the list has to be patched by id —
    /// mutating the argument would update nothing anyone can see.
    /// </summary>
    async Task RenameCategory(GridCommandEventArgs args)
    {
        var edited = (CategoryDto)args.Item;
        if (string.IsNullOrWhiteSpace(edited.Name))
        {
            args.IsCancelled = true;
            Toast.Error("ناوی پۆل ناتوانێت بەتاڵ بێت");
            return;
        }

        try
        {
            var updated = await WordSvc.UpdateCategoryAsync(edited.Id, edited.Name.Trim());
            if (updated is not null)
            {
                var idx = _categories.FindIndex(c => c.Id == updated.Id);
                if (idx >= 0) _categories[idx] = updated;
                _categories = _categories.OrderBy(c => c.Name).ToList();
            }
            Toast.Success("ناوەکە گۆڕدرا");
        }
        catch (Exception ex)
        {
            args.IsCancelled = true;
            Toast.Error($"گۆڕینی ناو سەرکەوتوو نەبوو — لەوانەیە ناوەکە دووبارە بێت. ({ex.Message})");
        }
    }

    async Task DeleteCategory(GridCommandEventArgs args)
    {
        var cat = (CategoryDto)args.Item;

        try
        {
            await WordSvc.DeleteCategoryAsync(cat.Id);
            _categories.RemoveAll(c => c.Id == cat.Id);

            if (_selectedCatId == cat.Id) ClearSelection();
            Toast.Success($"«{cat.Name}» سڕایەوە");
        }
        catch (Exception ex)
        {
            args.IsCancelled = true;
            Toast.Error($"سڕینەوە سەرکەوتوو نەبوو: {ex.Message}");
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Selection + member list
    // ═══════════════════════════════════════════════════════════════════════
    async Task OnCategorySelected(IEnumerable<CategoryDto> items)
    {
        _selectedCats = items;
        var cat = items.FirstOrDefault();

        _selectedCatId = cat?.Id;
        ResetRightPanel();

        if (cat is not null) await LoadMembers(reset: true);
    }

    async Task OnSpeechPaneSelected(IEnumerable<SpeechPaneStatDto> items)
    {
        _selectedPanes = items;
        var pane = items.FirstOrDefault();

        _selectedSpeechId = pane?.Id;
        ResetRightPanel();

        if (pane is not null) await LoadMembers(reset: true);
    }

    async Task LoadMembers(bool reset)
    {
        if (!HasSelection) return;
        if (reset) { _membersPage = 1; _members = new(); _membersLoading = true; }
        else _membersLoadingMore = true;

        try
        {
            var result = _tab == Tab.Categories
                ? await WordSvc.GetCategoryWordsAsync(_selectedCatId!.Value, _membersPage, MembersPageSize, _memberSearch)
                : await WordSvc.GetSpeechTypeWordsAsync(_selectedSpeechId!.Value, _membersPage, MembersPageSize, _memberSearch);

            var incoming = result?.Items ?? new();
            if (reset) _members = incoming;
            else _members.AddRange(incoming);

            _membersTotal = result?.TotalCount ?? _members.Count;
            _membersHasMore = _members.Count < _membersTotal;
        }
        catch (Exception ex)
        {
            Toast.Error($"بارکردنی وشەکان سەرکەوتوو نەبوو: {ex.Message}");
        }
        finally { _membersLoading = false; _membersLoadingMore = false; }
    }

    async Task LoadMoreMembers() { _membersPage++; await LoadMembers(reset: false); }

    async Task OnMemberSearch(ChangeEventArgs e)
    {
        _memberSearch = e.Value?.ToString() ?? "";
        _memberCts?.Cancel();
        _memberCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _memberCts.Token);
            await LoadMembers(reset: true);
        }
        catch (TaskCanceledException) { }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Add / remove membership
    // ═══════════════════════════════════════════════════════════════════════
    bool IsAlreadyMember(WordDto w) => _tab == Tab.Categories
        ? w.Categories.Any(c => c.Id == _selectedCatId)
        : w.SpeechPanes.Any(sp => sp.Id == _selectedSpeechId);

    /// <summary>
    /// The picker reads from the server on every keystroke rather than filtering a preloaded list:
    /// there are three thousand words and the box only ever needs ten of them.
    ///
    /// Words already in this class are dropped, but words the user has ALREADY PICKED are kept —
    /// Telerik renders the chips from Data, so filtering a picked item out of the list makes its
    /// chip lose its label and show a bare id.
    /// </summary>
    async Task OnWordSearch(MultiSelectReadEventArgs args)
    {
        var term = args.Request.Filters
            .OfType<Telerik.DataSource.FilterDescriptor>()
            .Select(f => f.Value?.ToString())
            .FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));

        if (string.IsNullOrWhiteSpace(term))
        {
            args.Data = _wordOptions.Where(w => _pickedIds.Contains(w.Id)).ToList();
            return;
        }

        try
        {
            var result = await WordSvc.GetWordsAsync(search: term, pageSize: 10);
            var found = (result?.Items ?? new()).Where(w => !IsAlreadyMember(w)).ToList();

            var keep = _wordOptions.Where(w => _pickedIds.Contains(w.Id) && found.All(f => f.Id != w.Id));

            _wordOptions = found.Concat(keep).ToList();
            args.Data = _wordOptions;
        }
        catch (Exception ex)
        {
            args.Data = new List<WordDto>();
            Toast.Error($"گەڕان سەرکەوتوو نەبوو: {ex.Message}");
        }
    }

    async Task AddPickedWords()
    {
        if (_pickedIds.Count == 0 || !HasSelection || _saving) return;

        _saving = true;
        var ids = _pickedIds.ToList();
        var failed = 0;

        try
        {
            foreach (var id in ids)
            {
                try
                {
                    if (_tab == Tab.Categories)
                        await WordSvc.AddWordToCategoryAsync(_selectedCatId!.Value, id);
                    else
                        await WordSvc.AddWordToSpeechTypeAsync(_selectedSpeechId!.Value, id);
                }
                catch
                {
                    // One rejected word must not abandon the other fourteen half-added.
                    failed++;
                }
            }

            _pickedIds = new();
            _wordOptions = new();
            await LoadMembers(reset: true);

            // With no active filter the paged total is authoritative; otherwise apply the delta.
            if (string.IsNullOrWhiteSpace(_memberSearch)) SetSelectedCount(_membersTotal);
            else UpdateSelectedCount(ids.Count - failed);

            if (failed == 0) Toast.Success($"{Ku.N(ids.Count)} وشە زیادکران");
            else Toast.Error($"{Ku.N(ids.Count - failed)} وشە زیادکران، {Ku.N(failed)} سەرکەوتوو نەبوون");
        }
        finally { _saving = false; }
    }

    async Task RemoveMember(WordDto w)
    {
        if (!HasSelection || _saving) return;
        _saving = true;

        try
        {
            if (_tab == Tab.Categories)
                await WordSvc.RemoveWordFromCategoryAsync(_selectedCatId!.Value, w.Id);
            else
                await WordSvc.RemoveWordFromSpeechTypeAsync(_selectedSpeechId!.Value, w.Id);

            _members.RemoveAll(m => m.Id == w.Id);
            _membersTotal = Math.Max(0, _membersTotal - 1);
            UpdateSelectedCount(-1);
        }
        catch (Exception ex)
        {
            Toast.Error($"لابردن سەرکەوتوو نەبوو: {ex.Message}");
        }
        finally { _saving = false; }
    }

    void UpdateSelectedCount(int delta)
    {
        if (_tab == Tab.Categories)
        {
            var cat = _categories.FirstOrDefault(c => c.Id == _selectedCatId);
            if (cat is not null) cat.WordCount = Math.Max(0, cat.WordCount + delta);
        }
        else
        {
            var sp = _speechStats.FirstOrDefault(s => s.Id == _selectedSpeechId);
            if (sp is not null) sp.WordCount = Math.Max(0, sp.WordCount + delta);
        }
    }

    void SetSelectedCount(int count)
    {
        if (_tab == Tab.Categories)
        {
            var cat = _categories.FirstOrDefault(c => c.Id == _selectedCatId);
            if (cat is not null) cat.WordCount = count;
        }
        else
        {
            var sp = _speechStats.FirstOrDefault(s => s.Id == _selectedSpeechId);
            if (sp is not null) sp.WordCount = count;
        }
    }
}

@page "/activity"
@page "/audit"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@* Injected as ActivitySvc, not Activity: a member may not share its name with the enclosing class. *@
@inject ActivityService ActivitySvc
@inject NavigationManager Nav

<PageTitle>چالاکییەکان — ژینزار</PageTitle>

<PageHeader Title="چالاکییەکان"
            Subtitle="هەموو زیادکردن، دەستکاری و سڕینەوەیەک — لەگەڵ ئەوەی کێ کردوویەتی، لە چ IPیەک و کەی">
    <Actions>
        <button @onclick="() => LoadAsync(1)" class="btn-secondary">نوێکردنەوە</button>
    </Actions>
</PageHeader>

@* ── Filters ─────────────────────────────────────────────────────────── *@
<div class="mb-4 flex flex-wrap items-center gap-1.5">
    @foreach (var filter in ActionFilters)
    {
        <button @onclick="() => SetActionAsync(filter.Value)" class="@FilterClass(filter.Value)">
            @filter.Label
        </button>
    }

    <div class="relative ms-auto">
        <span class="pointer-events-none absolute end-3 top-1/2 -translate-y-1/2 text-ink-3">
            <Icon Name="search" Class="h-3.5 w-3.5" />
        </span>
        <input @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyAsync"
               placeholder="گەڕان بە وشە، بەکارهێنەر یان IP…"
               class="field w-64 py-1.5 pe-9 text-xs" />
    </div>
</div>

@if (_loading)
{
    <div class="space-y-2">
        @for (var i = 0; i < 8; i++)
        {
            <div class="skeleton h-16 w-full rounded-card"></div>
        }
    </div>
}
else if (_logs is null || _logs.Items.Count == 0)
{
    <div class="card flex flex-col items-center gap-3 py-16 text-center">
        <span class="hatch h-12 w-12 rounded-full border border-line"></span>
        <p class="text-sm text-ink-1">هیچ چالاکییەک نەدۆزرایەوە</p>
    </div>
}
else
{
    <div class="card p-0">
        @foreach (var log in _logs.Items)
        {
            <div class="flex gap-3 border-b border-line p-4 transition-colors last:border-0 hover:bg-page">
                <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full @ActionStyle(log.Action)">
                    <Icon Name="@ActionIcon(log.Action)" Class="h-4 w-4" />
                </span>

                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5">
                        <span class="text-sm font-medium text-ink-1">@(log.UserName ?? "نەناسراو")</span>
                        <span class="text-sm text-ink-2">@ActionText(log.Action)</span>
                        <span class="text-sm font-medium text-ink-1">@(log.Summary ?? EntityLabel(log.EntityType))</span>
                        <span class="rounded-full bg-page px-2 py-0.5 text-11 text-ink-2">
                            @EntityLabel(log.EntityType)@(log.EntityId > 0 ? $" #{Ku.Raw(log.EntityId)}" : "")
                        </span>
                    </div>

                    @* Field-level diff — the "what exactly changed" that a plain log line can't show.
                       Old is struck through in danger, new is plain: only the removal needs marking. *@
                    @{
                        var changes = ActivityService.ParseChanges(log.Changes);
                    }
                    @if (changes.Count > 0)
                    {
                        <div class="mt-2 space-y-1 rounded-chip bg-page p-2.5">
                            @foreach (var change in changes)
                            {
                                <div class="flex flex-wrap items-center gap-1.5 text-xs">
                                    <span class="text-ink-3">@FieldLabel(change.Field):</span>
                                    <span class="rounded-chip bg-danger-tint px-1.5 py-0.5 text-danger line-through">
                                        @Display(change.Old)
                                    </span>
                                    <span class="text-ink-3">←</span>
                                    <span class="rounded-chip bg-green-tint px-1.5 py-0.5 text-on-tint">
                                        @Display(change.New)
                                    </span>
                                </div>
                            }
                        </div>
                    }

                    <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-11 text-ink-3">
                        <span title="@log.CreatedAt.ToString("u")">@Ago(log.CreatedAt)</span>

                        @if (!string.IsNullOrEmpty(log.IpAddress))
                        {
                            <a href="@($"https://ipinfo.io/{log.IpAddress}")" target="_blank" rel="noopener"
                               class="inline-flex items-center gap-1 font-mono text-green hover:underline">
                                <Icon Name="globe" Class="h-3 w-3" />
                                <bdi>@log.IpAddress</bdi>
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(log.City) || !string.IsNullOrEmpty(log.Country))
                        {
                            <span class="inline-flex items-center gap-1">
                                <Icon Name="pin" Class="h-3 w-3" />
                                @string.Join("، ", new[] { log.City, log.Country }.Where(x => !string.IsNullOrEmpty(x)))
                            </span>
                        }

                        @if (!string.IsNullOrEmpty(log.UserAgent))
                        {
                            <span class="inline-flex max-w-xs items-center gap-1 truncate" title="@log.UserAgent">
                                <Icon Name="monitor" Class="h-3 w-3 shrink-0" />
                                <bdi class="truncate">@log.UserAgent</bdi>
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── Paging ───────────────────────────────────────────────────────── *@
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-ink-2">
            <bdi>@Ku.N(_logs.TotalCount)</bdi> تۆمار — لاپەڕەی <bdi>@Ku.N(_page)</bdi> لە <bdi>@Ku.N(TotalPages)</bdi>
        </p>
        <div class="flex gap-2">
            <button @onclick="() => LoadAsync(_page - 1)" disabled="@(_page <= 1)"
                    class="btn-secondary py-1.5 text-xs disabled:cursor-not-allowed disabled:opacity-40">
                پێشوو
            </button>
            <button @onclick="() => LoadAsync(_page + 1)" disabled="@(_page >= TotalPages)"
                    class="btn-secondary py-1.5 text-xs disabled:cursor-not-allowed disabled:opacity-40">
                دواتر
            </button>
        </div>
    </div>
}

@code {
    private const int PageSize = 30;

    private static readonly (string Label, string? Value)[] ActionFilters =
    {
        ("هەمووی", null),
        ("زیادکراو", "Create"),
        ("دەستکاریکراو", "Update"),
        ("سڕدراوە", "Delete"),
        ("چوونەژوورەوە", "Login"),
        ("هەوڵی سەرنەکەوتوو", "LoginFailed"),
    };

    private PagedResultDto<AuditLogDto>? _logs;
    private bool _loading = true;
    private int _page = 1;
    private string? _action;
    private string _search = "";

    private int TotalPages => _logs is null || _logs.TotalCount == 0
        ? 1
        : (int)Math.Ceiling(_logs.TotalCount / (double)PageSize);

    protected override async Task OnInitializedAsync() => await LoadAsync(1);

    private async Task SetActionAsync(string? action)
    {
        _action = action;
        await LoadAsync(1);
    }

    private async Task OnSearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        if (page < 1) return;

        _loading = true;
        _page = page;
        StateHasChanged();

        try
        {
            _logs = await ActivitySvc.GetAsync(page, PageSize, _action, search: _search);
        }
        catch (ApiUnauthorizedException)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value.Length > 60 ? value[..60] + "…" : value;

    private static string FieldLabel(string field) => field switch
    {
        "Kurdish" => "وشە",
        "Description" => "وەسف",
        "Gender" => "ڕەگەز",
        "Name" => "ناو",
        "Meaning" => "واتا",
        "Locate" => "شوێن",
        "RelationType" => "جۆری پەیوەندی",
        "Weight" => "کێش",
        _ => field,
    };

    private static string ActionIcon(string action) => action switch
    {
        "Create" => "plus",
        "Update" => "pencil",
        "Delete" => "trash",
        "Login" => "login",
        "LoginFailed" => "alert",
        _ => "check",
    };

    /// <summary>Colour marks the kind of action, never the person who performed it.</summary>
    private static string ActionStyle(string action) => action switch
    {
        "Create" => "bg-green-tint text-on-tint",
        "Update" => "bg-warn-tint text-warn",
        "Delete" or "LoginFailed" => "bg-danger-tint text-danger",
        _ => "bg-page text-ink-2",
    };

    private string FilterClass(string? value) => _action == value
        ? "rounded-full bg-green-deep px-3 py-1.5 text-xs font-medium text-white"
        : "rounded-full border border-line bg-card px-3 py-1.5 text-xs text-ink-2 transition-colors hover:bg-page";

    private static string ActionText(string action) => action switch
    {
        "Create" => "زیادیکرد",
        "Update" => "دەستکاریی کرد",
        "Delete" => "سڕییەوە",
        "Login" => "چووە ژوورەوە",
        "LoginFailed" => "هەوڵی سەرنەکەوتووی چوونەژوورەوە",
        "CreateUser" => "بەکارهێنەری زیادکرد",
        "UpdateUser" => "بەکارهێنەری دەستکاری کرد",
        "DeleteUser" => "بەکارهێنەری سڕییەوە",
        _ => action,
    };

    private static string EntityLabel(string entityType) => entityType switch
    {
        "Word" => "وشە",
        "Category" => "پۆل",
        "WordMeans" => "واتا",
        "RelatedWord" => "پەیوەندی",
        "WordCategory" => "پۆلێنکردن",
        "WordSpeechPane" => "بەشی ئاخاوتن",
        "User" => "بەکارهێنەر",
        _ => entityType,
    };

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;

        if (span.TotalSeconds < 60) return "ئێستا";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} خولەک لەمەوپێش";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} کاتژمێر لەمەوپێش";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays} ڕۆژ لەمەوپێش";
        return utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }
}

@page "/analytics"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@implements IDisposable
@* Injected as AnalyticsSvc, not Analytics: a member may not share its name with the enclosing class. *@
@inject AnalyticsService AnalyticsSvc
@inject NavigationManager Nav

<PageTitle>ترافیکی ماڵپەڕ — ژینزار</PageTitle>

<PageHeader Title="ترافیکی ماڵپەڕی گشتی"
            Subtitle="کێ ماڵپەڕەکە دەکاتەوە، بۆ چی دەگەڕێت، لە کوێوە — بە شار، وڵات و ئامێرەوە">
    <Actions>
        @foreach (var range in Ranges)
        {
            <button @onclick="() => SetRangeAsync(range.Days)" class="@RangeClass(range.Days)">
                @range.Label
            </button>
        }
    </Actions>
</PageHeader>

@if (_loading)
{
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @for (var i = 0; i < 4; i++)
        {
            <div class="skeleton h-28 rounded-card"></div>
        }
    </div>
    <div class="skeleton mt-4 h-64 rounded-card"></div>
}
else if (_data is null)
{
    <div class="card flex flex-col items-center gap-3 py-16 text-center">
        <span class="hatch h-12 w-12 rounded-full border border-line"></span>
        <p class="text-sm text-ink-1">ناتوانرێت داتاکان بهێنرێت</p>
    </div>
}
else
{
    @* ── Stat tiles ──────────────────────────────────────────────────── *@
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <StatTile Label="ئێستا لە ماڵپەڕ" Value="@Ku.N(_data.ActiveNow)" IconName="globe"
                  Hint="لە ٥ خولەکی ڕابردوودا" />
        <StatTile Label="سەردانی ئەمڕۆ" Value="@Ku.N(_data.VisitsToday)" IconName="chart"
                  Hint="@($"{Ku.N(_data.UniqueVisitorsToday)} سەردانکەری جیاواز")" />
        <StatTile Label="گەڕانی ئەمڕۆ" Value="@Ku.N(_data.SearchesToday)" IconName="search"
                  Hint="@($"کۆی گشتی {Ku.N(_data.TotalSearches)}")" />
        <StatTile Label="گەڕانی بێ ئەنجام" Value="@Ku.N(_data.EmptySearches)" IconName="alert"
                  Hint="وشەی نەدۆزراوە — بۆ زیادکردن" />
    </div>

    @* ── Traffic chart ───────────────────────────────────────────────── *@
    <section class="card mt-4">
        <div class="mb-4 flex items-center justify-between">
            <h2 class="card-title">سەردان و گەڕان بە ڕۆژ</h2>
            @* Two series, two rungs of the ramp — never a second hue. *@
            <div class="flex gap-3 text-11">
                <span class="flex items-center gap-1.5">
                    <span class="h-2 w-2 rounded-full bg-green"></span>
                    <span class="text-ink-2">سەردان</span>
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="h-2 w-2 rounded-full bg-green-mid"></span>
                    <span class="text-ink-2">گەڕان</span>
                </span>
            </div>
        </div>

        @* Bars in plain CSS — a chart library would be a lot of weight for one column chart. *@
        <div class="flex h-40 items-end gap-1">
            @{
                var peak = Math.Max(1, _data.DailyVisits.Concat(_data.DailySearches).DefaultIfEmpty(new DailyCountDto()).Max(d => d.Count));
            }
            @for (var i = 0; i < _data.DailyVisits.Count; i++)
            {
                var visits = _data.DailyVisits[i];
                var searches = i < _data.DailySearches.Count ? _data.DailySearches[i].Count : 0;

                <div class="group relative flex flex-1 items-end gap-0.5" title="@visits.Date.ToString("yyyy-MM-dd")">
                    <div class="flex-1 rounded-t-full bg-green" style="height: @(Percent(visits.Count, peak))%"></div>
                    <div class="flex-1 rounded-t-full bg-green-mid" style="height: @(Percent(searches, peak))%"></div>

                    <div class="pointer-events-none absolute -top-14 start-1/2 z-10 hidden -translate-x-1/2 whitespace-nowrap rounded-chip bg-green-deep px-2 py-1 text-11 text-white group-hover:block">
                        <p><bdi>@Ku.Sub(visits.Date.ToString("MM-dd"))</bdi></p>
                        <p><bdi>@Ku.N(visits.Count)</bdi> سەردان · <bdi>@Ku.N(searches)</bdi> گەڕان</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <div class="mt-4 grid gap-4 lg:grid-cols-2">

        @* ── Top searches ────────────────────────────────────────────── *@
        <section class="card">
            <h2 class="card-title mb-4">زۆرترین گەڕان</h2>
            @if (_data.TopSearches.Count == 0)
            {
                <p class="py-8 text-center text-sm text-ink-3">هێشتا هیچ گەڕانێک نییە</p>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var term in _data.TopSearches.Take(10))
                    {
                        <div class="flex items-center gap-3">
                            <span class="min-w-0 flex-1 truncate text-sm text-ink-1">@term.Term</span>
                            @if (term.LastResultCount == 0)
                            {
                                <span class="shrink-0 rounded-full bg-warn-tint px-2 py-0.5 text-11 text-warn">
                                    بێ ئەنجام
                                </span>
                            }
                            <div class="hatch h-1.5 w-24 shrink-0 overflow-hidden rounded-full border border-line">
                                <div class="h-full rounded-full bg-green"
                                     style="width: @(Percent(term.Count, _data.TopSearches.Max(s => s.Count)))%"></div>
                            </div>
                            <span class="w-8 shrink-0 text-end text-xs text-ink-2"><bdi>@Ku.N(term.Count)</bdi></span>
                        </div>
                    }
                </div>
            }
        </section>

        @* ── Failed searches: the words worth adding ─────────────────── *@
        <section class="rounded-card border border-line bg-warn-tint p-5">
            <h2 class="card-title mb-1">گەڕانی بێ ئەنجام</h2>
            <p class="mb-4 text-xs text-ink-2">ئەم وشانە خەڵک بەدوایاندا دەگەڕێن بەڵام لە فەرهەنگدا نین</p>

            @if (_data.FailedSearches.Count == 0)
            {
                <p class="py-8 text-center text-sm text-ink-2">هەموو گەڕانەکان ئەنجامیان هەبووە</p>
            }
            else
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var term in _data.FailedSearches.Take(20))
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-chip border border-line bg-card px-2.5 py-1.5 text-xs">
                            <span class="font-medium text-ink-1">@term.Term</span>
                            <span class="text-11 text-warn"><bdi>@Ku.N(term.Count)</bdi></span>
                        </span>
                    }
                </div>
            }
        </section>
    </div>

    @* ── Breakdown grids ─────────────────────────────────────────────── *@
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <BreakdownCard Title="وڵاتەکان" Items="_data.TopCountries" />
        <BreakdownCard Title="شارەکان" Items="_data.TopCities" />
        <BreakdownCard Title="ئامێرەکان" Items="_data.Devices" />
        <BreakdownCard Title="وێبگەڕەکان" Items="_data.Browsers" />
    </div>

    <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <BreakdownCard Title="زۆرترین پەڕە" Items="_data.TopPages" />
        <BreakdownCard Title="سەرچاوەکان" Items="_data.TopReferrers" />
    </div>

    @* ── Live visitor feed ───────────────────────────────────────────── *@
    <section class="card mt-4 overflow-hidden p-0">
        <div class="flex items-center gap-2 border-b border-line px-5 py-3">
            <span class="h-2 w-2 rounded-full bg-green"></span>
            <h2 class="card-title">چالاکی زیندوو</h2>
            <span class="text-xs text-ink-3">— هەر ١٠ چرکە نوێدەبێتەوە</span>
        </div>

        <div class="max-h-[28rem] overflow-y-auto">
            @if (_events.Count == 0)
            {
                <p class="py-12 text-center text-sm text-ink-3">هێشتا هیچ سەردانێک نییە</p>
            }
            else
            {
                @foreach (var e in _events)
                {
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-line px-5 py-3 text-xs last:border-0 hover:bg-page">
                        <span class="rounded-full px-2 py-0.5 text-11 @EventStyle(e.EventType)">
                            @EventLabel(e.EventType)
                        </span>

                        @if (e.EventType == "search" && !string.IsNullOrEmpty(e.SearchTerm))
                        {
                            <span class="font-medium text-ink-1">«@e.SearchTerm»</span>
                            <span class="@(e.ResultCount == 0 ? "text-warn" : "text-ink-3")">
                                @(e.ResultCount == 0 ? "هیچ ئەنجامێک" : $"{Ku.N(e.ResultCount.GetValueOrDefault())} ئەنجام")
                            </span>
                        }
                        else if (!string.IsNullOrEmpty(e.Path))
                        {
                            <span class="font-mono text-ink-2"><bdi>@e.Path</bdi></span>
                        }

                        <span class="ms-auto flex flex-wrap items-center gap-x-3 gap-y-1 text-ink-3">
                            @if (!string.IsNullOrEmpty(e.City) || !string.IsNullOrEmpty(e.Country))
                            {
                                <span class="inline-flex items-center gap-1">
                                    <Icon Name="pin" Class="h-3.5 w-3.5" />
                                    @string.Join("، ", new[] { e.City, e.Country }.Where(x => !string.IsNullOrEmpty(x)))
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(e.IpAddress))
                            {
                                <span class="font-mono"><bdi>@e.IpAddress</bdi></span>
                            }
                            @if (!string.IsNullOrEmpty(e.DeviceType))
                            {
                                <span class="inline-flex items-center gap-1">
                                    <Icon Name="@DeviceIcon(e.DeviceType)" Class="h-3.5 w-3.5" />
                                    @e.Browser
                                </span>
                            }
                            @if (e.ScreenWidth is > 0)
                            {
                                <span class="inline-flex items-center gap-1">
                                    <Icon Name="monitor" Class="h-3.5 w-3.5" />
                                    <bdi>@Ku.Raw(e.ScreenWidth.GetValueOrDefault())×@Ku.Raw(e.ScreenHeight.GetValueOrDefault())</bdi>
                                </span>
                            }
                            <span title="@e.CreatedAt.ToString("u")">@Ago(e.CreatedAt)</span>
                        </span>
                    </div>
                }
            }
        </div>
    </section>
}

@code {
    private static readonly (string Label, int Days)[] Ranges =
    {
        ("٧ ڕۆژ", 7),
        ("١٤ ڕۆژ", 14),
        ("٣٠ ڕۆژ", 30),
    };

    private AnalyticsSummaryDto? _data;
    private readonly List<VisitorEventDto> _events = new();
    private Timer? _timer;
    private long _lastEventId;
    private int _days = 14;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        _timer = new Timer(async _ => await InvokeAsync(PollLiveAsync), null,
            TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task SetRangeAsync(int days)
    {
        _days = days;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _data = await AnalyticsSvc.GetSummaryAsync(_days);

            _events.Clear();
            _events.AddRange(_data?.RecentEvents ?? new List<VisitorEventDto>());
            _lastEventId = _events.Count > 0 ? _events.Max(e => e.Id) : 0;
        }
        catch (ApiUnauthorizedException)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        catch (HttpRequestException)
        {
            _data = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PollLiveAsync()
    {
        try
        {
            var fresh = await AnalyticsSvc.GetLiveAsync(_lastEventId);
            if (fresh.Count == 0) return;

            // Newest first at the top of the feed; keep the list bounded so a busy day
            // doesn't grow the circuit's memory without limit.
            _events.InsertRange(0, fresh.OrderByDescending(e => e.Id));
            if (_events.Count > 100) _events.RemoveRange(100, _events.Count - 100);

            _lastEventId = fresh.Max(e => e.Id);
            StateHasChanged();
        }
        catch (ApiUnauthorizedException)
        {
            _timer?.Dispose();
            Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            // Transient — the next tick will pick up whatever we missed, since we poll by id.
        }
    }

    private static int Percent(int value, int max) =>
        max <= 0 ? 0 : Math.Max(value > 0 ? 3 : 0, (int)(value / (double)max * 100));

    private static string EventLabel(string type) => type switch
    {
        "page_view" => "سەردان",
        "search" => "گەڕان",
        "word_view" => "وشە",
        "share" => "هاوبەشکردن",
        _ => type,
    };

    /// <summary>Colour marks the KIND of event. Only two tints exist, so the feed stays scannable
    /// without turning into a second palette.</summary>
    private static string EventStyle(string type) => type switch
    {
        "search" or "word_view" => "bg-green-tint text-on-tint",
        _ => "bg-page text-ink-2",
    };

    private static string DeviceIcon(string device) => device switch
    {
        "Mobile" => "phone",
        "Tablet" => "tablet",
        _ => "monitor",
    };

    /// <summary>Range buttons live in the page header, so they use the standard pill pair.</summary>
    private string RangeClass(int days) => _days == days
        ? "rounded-full bg-green-deep px-3 py-1.5 text-xs font-medium text-white"
        : "rounded-full border border-line bg-card px-3 py-1.5 text-xs text-ink-2 transition-colors hover:bg-page";

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;

        if (span.TotalSeconds < 60) return "ئێستا";
        if (span.TotalMinutes < 60) return $"{Ku.Raw((int)span.TotalMinutes)}خ";
        if (span.TotalHours < 24) return $"{Ku.Raw((int)span.TotalHours)}ک";
        return $"{Ku.Raw((int)span.TotalDays)}ڕ";
    }

    public void Dispose() => _timer?.Dispose();
}

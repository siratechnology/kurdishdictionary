@page "/relations"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin,Editor")]
@inject RelationService Relations
@inject Toast Toast

<PageTitle>پەیوەندییەکان — ژینزار</PageTitle>

@* Relations: walk the dictionary, wire each word to others.

   TWO PANES, and that is the whole structure. Left is the word you are on — who it is and what it
   is already wired to. Right is the one job: pick a type, tick words, press add.

   The version before this split that job across three numbered cards stacked down the page, which
   made a two-click task look like a form and pushed the button below the fold. It also asked which
   sense to use on every semantic relation — a question that is genuinely ambiguous for 3 words in
   59 and pure friction for the other 56. Now it defaults to the only sense there is and asks only
   when a word actually has more than one.

   Targets are MULTI-select. Wiring six synonyms is one action, not six. *@

<TelerikScope>

<PageHeader Title="پەیوەندییەکان" Subtitle="@Subtitle">
    <Actions>
        @if (_coverage is { } c)
        {
            <span class="pill @(c.WordsWithRelations > 0 ? "pill-ok" : "pill-warn")">
                <bdi>@Ku.N(c.WordsWithRelations)</bdi> / <bdi>@Ku.N(c.TotalWords)</bdi>
            </span>
        }
    </Actions>
</PageHeader>

@* ── Walk bar ─────────────────────────────────────────────────────────── *@
<div class="card mb-4 flex flex-wrap items-center gap-2 px-4 py-2.5">
    <button @onclick="() => Go(_position - 1)" disabled="@(_position <= 1 || _busy)" class="btn-secondary">
        پێشوو
    </button>
    <button @onclick="() => Go(_position + 1)" disabled="@(_position >= _total || _busy)" class="btn-secondary">
        دواتر
    </button>

    <div class="flex items-center gap-1.5 text-sm text-ink-2">
        <input type="number" value="@_position" @onchange="OnJump" min="1" max="@_total"
               class="field w-24 py-1.5 text-center text-sm" aria-label="ژمارەی وشە" />
        <span>لە <bdi class="text-ink-1">@Ku.N(_total)</bdi></span>
    </div>

    <button @onclick="SkipToMissing" disabled="@_busy" class="btn-secondary">بێ پەیوەندی دواتر</button>

    @if (_coverage is { } cv)
    {
        <div class="ms-auto h-1.5 w-32 overflow-hidden rounded-full bg-page" title="@Subtitle">
            <div class="h-full rounded-full bg-green-deep" style="width: @Percent(cv)%"></div>
        </div>
    }
</div>

@if (_word is null)
{
    <div class="card flex flex-col items-center gap-3 py-16 text-center">
        <span class="hatch h-12 w-12 rounded-full border border-line"></span>
        <p class="text-sm text-ink-2">@(_busy ? "…" : "هیچ وشەیەک نەهاتەوە")</p>
    </div>
}
else
{
<div class="grid gap-4 lg:grid-cols-2">

    @* ══ LEFT — the word and what it already has ════════════════════════ *@
    <div class="space-y-4">
        <div class="card">
            <span class="text-34 font-medium text-ink-1">@_word.Kurdish</span>

            @if (!string.IsNullOrWhiteSpace(_word.Description))
            {
                <p class="mt-1.5 text-sm leading-relaxed text-ink-2">@_word.Description</p>
            }

            @foreach (var s in _word.Senses)
            {
                <p class="mt-1 truncate text-xs text-ink-3">@s.Label</p>
            }
        </div>

        <div class="card">
            <div class="mb-3 flex items-center gap-2.5">
                <span class="card-badge"><Icon Name="relations" Class="h-4 w-4" /></span>
                <h2 class="card-title">پەیوەندییەکان</h2>
                <span class="pill @(_word.Relations.Count == 0 ? "pill-warn" : "pill-ok") ms-auto">
                    <bdi>@Ku.N(_word.Relations.Count)</bdi>
                </span>
            </div>

            @if (_word.Relations.Count == 0)
            {
                <p class="py-6 text-center text-sm text-ink-2">هێشتا هیچ پەیوەندییەک نییە</p>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var group in _word.Relations.GroupBy(r => r.TypeNameKu))
                    {
                        <div>
                            <p class="mb-1.5 text-11 text-ink-3">@group.Key</p>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var rel in group)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-green-tint py-1 pe-3 ps-1.5 text-sm text-on-tint"
                                          title="@RelTitle(rel)">
                                        <button @onclick="() => Remove(rel)" disabled="@_busy"
                                                class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full transition-colors hover:bg-card disabled:opacity-40"
                                                aria-label="سڕینەوە">
                                            <Icon Name="close" Class="h-2.5 w-2.5" />
                                        </button>
                                        @rel.OtherWord
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ══ RIGHT — add ════════════════════════════════════════════════════ *@
    <div class="card flex flex-col">

        @* The type. A dropdown rather than eleven chips: eleven chips is a wall, and the two
           groups are what carry the meaning — morphology belongs to the WORD, semantics to one
           SENSE. Optgroups say that in the control itself. *@
        <label class="field-label">جۆری پەیوەندی</label>
        <select value="@_typeId" @onchange="OnTypeChanged" class="field">
            <option value="0">— جۆرێک هەڵبژێرە —</option>
            <optgroup label="پەیوەندی وشەیی (ڕەگ و پێکهاتە)">
                @foreach (var t in _types.Where(t => t.Scope == "word"))
                {
                    <option value="@t.Id">@t.NameKu</option>
                }
            </optgroup>
            <optgroup label="پەیوەندی مانایی (واتا)">
                @foreach (var t in _types.Where(t => t.Scope == "sense"))
                {
                    <option value="@t.Id">@t.NameKu</option>
                }
            </optgroup>
        </select>

        @if (SelectedType is { } sel)
        {
            <p class="mt-1.5 text-11 leading-relaxed text-ink-3">@InverseHint(sel)</p>
        }

        @* Which sense of THIS word — only when the type is semantic and the word has a choice. *@
        @if (SelectedType?.IsSenseScoped == true && _word.Senses.Count > 1)
        {
            <label class="field-label mt-3">مانای «@_word.Kurdish»</label>
            <select value="@_fromSenseId" @onchange="OnFromSenseChanged" class="field">
                @foreach (var s in _word.Senses)
                {
                    <option value="@s.SenseId">@s.Label</option>
                }
            </select>
        }

        @* ── Search + list ───────────────────────────────────────────── *@
        <div class="relative mt-4">
            <span class="pointer-events-none absolute end-3 top-1/2 -translate-y-1/2 text-ink-3">
                <Icon Name="search" Class="h-4 w-4" />
            </span>
            <input value="@_search" @oninput="OnSearch"
                   placeholder="وشە بە پیتی سەرەتا بگەڕێ…" class="field pe-10" />
        </div>

        @if (_picked.Any())
        {
            <div class="mt-3 flex flex-wrap gap-1.5">
                @foreach (var p in _picked.Values)
                {
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-green-tint py-1 pe-3 ps-1.5 text-sm text-on-tint">
                        <button @onclick="() => Toggle(p)" class="flex h-4 w-4 items-center justify-center rounded-full hover:bg-card"
                                aria-label="لابردن">
                            <Icon Name="close" Class="h-2.5 w-2.5" />
                        </button>
                        @p.Kurdish
                    </span>
                }
            </div>
        }

        <div class="mt-3 max-h-80 min-h-[8rem] overflow-y-auto rounded-chip border border-line-soft">
            @if (!_results.Any())
            {
                <p class="py-8 text-center text-sm text-ink-2">
                    @(string.IsNullOrWhiteSpace(_search) ? "…" : "هیچ وشەیەک نەدۆزرایەوە")
                </p>
            }
            else
            {
                @foreach (var r in _results)
                {
                    var blocked = NeedsSense && r.SenseCount == 0;

                    <button type="button" @onclick="() => Toggle(r)" disabled="@blocked" class="@RowClass(r, blocked)">
                        <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded border @(_picked.ContainsKey(r.Id) ? "border-green bg-green-deep text-white" : "border-line")">
                            @if (_picked.ContainsKey(r.Id))
                            {
                                <Icon Name="check" Class="h-2.5 w-2.5" />
                            }
                        </span>

                        <span class="min-w-0 flex-1 text-start">
                            <span class="block truncate text-sm text-ink-1">@r.Kurdish</span>
                            @if (!string.IsNullOrWhiteSpace(r.Description))
                            {
                                <span class="block truncate text-11 text-ink-3">@r.Description</span>
                            }
                        </span>

                        @if (blocked)
                        {
                            <span class="shrink-0 text-11 text-warn">بێ مانا</span>
                        }
                        else if (r.RelationCount > 0)
                        {
                            <span class="shrink-0 text-11 text-ink-3"><bdi>@Ku.N(r.RelationCount)</bdi></span>
                        }
                    </button>

                    @* The only genuinely ambiguous case: a semantic relation onto a word that has
                       more than one sense. Shown inline on the row it belongs to, and only once the
                       row is ticked — asking before that is asking about a word nobody chose. *@
                    @if (NeedsSense && _picked.ContainsKey(r.Id) && r.SenseCount > 1)
                    {
                        <div class="border-b border-line-soft bg-page px-3 pb-2.5">
                            <label class="field-label !mb-1 !text-11">کام مانای «@r.Kurdish»؟</label>
                            <select value="@TargetSense(r.Id)" @onchange="e => OnTargetSenseChanged(r.Id, e)"
                                    class="field py-1.5 text-xs">
                                @foreach (var s in r.Senses)
                                {
                                    <option value="@s.SenseId">@s.Label</option>
                                }
                            </select>
                        </div>
                    }
                }
            }
        </div>

        @* ── Pager ───────────────────────────────────────────────────────
           The whole dictionary is browsable from here, not just whatever twenty rows a prefix
           happens to return. Ticks survive a page change — _picked is keyed by word id and holds
           the row itself, so a word chosen on page ٢ is still chosen, and still named, on page ٧. *@
        @if (_resultTotal > 0)
        {
            <div class="mt-2 flex items-center gap-2 text-11 text-ink-3">
                <button @onclick="() => GoToPage(_resultPage - 1)" disabled="@(_resultPage <= 1 || _busy)"
                        class="rounded-chip border border-line px-2 py-1 text-ink-2 transition-colors hover:bg-page disabled:opacity-40">
                    پێشوو
                </button>
                <button @onclick="() => GoToPage(_resultPage + 1)" disabled="@(_resultPage >= ResultPages || _busy)"
                        class="rounded-chip border border-line px-2 py-1 text-ink-2 transition-colors hover:bg-page disabled:opacity-40">
                    دواتر
                </button>

                <span>
                    پەڕەی <bdi class="text-ink-1">@Ku.N(_resultPage)</bdi> لە <bdi>@Ku.N(ResultPages)</bdi>
                </span>

                <span class="ms-auto"><bdi>@Ku.N(_resultTotal)</bdi> وشە</span>
            </div>
        }

        @* ── Save ────────────────────────────────────────────────────── *@
        <div class="mt-4 border-t border-line-soft pt-3">
            @if (Blocker is { } why)
            {
                <p class="mb-2 text-xs text-ink-3">@why</p>
            }

            <button @onclick="Add" disabled="@(Blocker is not null || _busy)"
                    class="btn-primary w-full justify-center disabled:opacity-40">
                @(_busy ? "پاشەکەوت…" : SaveLabel)
            </button>
        </div>
    </div>
</div>
}

</TelerikScope>

@code {
    RelationCoverageDto? _coverage;
    List<RelationTypeDto> _types = new();

    WordRelationsDto? _word;
    int _position = 1, _total;
    bool _busy;

    // ── The add form ────────────────────────────────────────────────────────
    int _typeId;
    int _fromSenseId;

    /// <summary>Ticked targets, by word id. A dictionary so the chips can name them without a lookup.</summary>
    readonly Dictionary<int, RelationTargetDto> _picked = new();

    /// <summary>Target word id → chosen sense, only for the few targets that have more than one.</summary>
    readonly Dictionary<int, int> _targetSense = new();

    string _search = "";
    List<RelationTargetDto> _results = new();
    int _resultPage = 1, _resultTotal;
    const int ResultPageSize = 20;

    int ResultPages => _resultTotal <= 0 ? 1 : (int)Math.Ceiling(_resultTotal / (double)ResultPageSize);

    CancellationTokenSource? _searchCts;

    RelationTypeDto? SelectedType => _types.FirstOrDefault(t => t.Id == _typeId);

    /// <summary>The chosen type needs a sense on both sides.</summary>
    bool NeedsSense => SelectedType?.IsSenseScoped == true;

    string Subtitle => _coverage is { } c
        ? $"{Ku.N(c.WordsWithoutRelations)} وشە بەبێ پەیوەندی لە کۆی {Ku.N(c.TotalWords)}"
        : "…";

    /// <summary>
    /// Why the button is off, in the user's words — or null when it is on.
    ///
    /// Every branch here names something VISIBLE on screen. The version before this could block on
    /// a sense that was never asked for, so the button sat dead with no control anywhere to fix it;
    /// senses now default to the only one there is, which leaves type and targets as the only two
    /// things that can be missing, and both are a control you are looking at.
    /// </summary>
    string? Blocker
    {
        get
        {
            if (_word is null) return "هیچ وشەیەک نەهاتەوە";
            if (SelectedType is null) return "جۆری پەیوەندی هەڵبژێرە";
            if (_picked.Count == 0) return "لانیکەم یەک وشە هەڵبژێرە";

            if (NeedsSense && _word.Senses.Count == 0)
                return $"«{_word.Kurdish}» هیچ مانایەکی نییە — لە وێستگە مانای بۆ زیاد بکە";

            return null;
        }
    }

    string SaveLabel => _picked.Count switch
    {
        0 => "زیادکردنی پەیوەندی",
        1 => $"«{_picked.Values.First().Kurdish}» زیاد بکە",
        var n => $"زیادکردنی {Ku.N(n)} پەیوەندی",
    };

    protected override async Task OnInitializedAsync()
    {
        try { _types = await Relations.GetTypesAsync(); }
        catch (Exception ex) { Toast.Error($"جۆرەکان نەهاتنەوە: {ex.Message}"); }

        await LoadCoverage();
        await Go(1);
    }

    async Task LoadCoverage()
    {
        try
        {
            _coverage = await Relations.GetCoverageAsync();
            if (_coverage is { } c) _total = c.TotalWords;
        }
        catch { /* The header goes quiet; the walk still works. */ }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Walk
    // ═══════════════════════════════════════════════════════════════════════

    async Task Go(int position) => await Load(() => Relations.GetAtAsync(position));

    async Task OnJump(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) await Go(n);
    }

    async Task SkipToMissing()
    {
        // Counted from the CURRENT position, so pressing it twice moves twice.
        var next = await Relations.NextMissingAsync(_position);

        if (next is not { } position)
        {
            Toast.Success("هەموو وشەکان پەیوەندییان هەیە.");
            return;
        }

        await Go(position);
    }

    async Task Load(Func<Task<WordRelationsDto?>> fetch)
    {
        _busy = true;
        try
        {
            _word = await fetch();
            if (_word is null) return;

            _position = _word.Position;
            _total = _word.Total;

            // Cleared on purpose. Carrying a ticked word across would leave it selected against a
            // headword nobody chose it for, and the next press would wire two unrelated words.
            _picked.Clear();
            _targetSense.Clear();

            _fromSenseId = _word.Senses.Count > 0 ? _word.Senses[0].SenseId : 0;

            await RunSearch(page: 1);
        }
        catch (Exception ex)
        {
            Toast.Error($"وشەکە نەهاتەوە: {ex.Message}");
        }
        finally { _busy = false; }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // The form
    // ═══════════════════════════════════════════════════════════════════════

    void OnTypeChanged(ChangeEventArgs e)
    {
        _typeId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

        // Switching to a semantic type on a word with no senses, or away from one, invalidates
        // nothing that is still on screen — but a target ticked while it was allowed can become
        // unusable, so drop the ones that no longer qualify rather than fail at save time.
        if (NeedsSense)
        {
            foreach (var id2 in _picked.Where(p => p.Value.SenseCount == 0).Select(p => p.Key).ToList())
            {
                _picked.Remove(id2);
                _targetSense.Remove(id2);
            }
        }
    }

    void OnFromSenseChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id)) _fromSenseId = id;
    }

    void OnTargetSenseChanged(int wordId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id)) _targetSense[wordId] = id;
    }

    /// <summary>The sense a target will be wired through — the explicit choice, or its first.</summary>
    int TargetSense(int wordId) =>
        _targetSense.TryGetValue(wordId, out var chosen)
            ? chosen
            : _picked.GetValueOrDefault(wordId)?.DefaultSenseId
              ?? _results.FirstOrDefault(r => r.Id == wordId)?.DefaultSenseId
              ?? 0;

    void Toggle(RelationTargetDto target)
    {
        if (_picked.Remove(target.Id)) { _targetSense.Remove(target.Id); return; }

        _picked[target.Id] = target;
    }

    async Task OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);

            // Back to page one: the old page number belongs to the old result set, and staying on
            // page seven of a search that now has two pages shows an empty list that looks broken.
            if (!token.IsCancellationRequested) await RunSearch(page: 1);
        }
        catch (TaskCanceledException) { }
    }

    async Task GoToPage(int page) => await RunSearch(Math.Clamp(page, 1, ResultPages));

    async Task RunSearch(int page)
    {
        if (_word is null) return;

        try
        {
            var result = await Relations.SearchAsync(_search, _word.WordId, page, ResultPageSize);

            _results = result?.Items ?? new();
            _resultTotal = result?.TotalCount ?? 0;
            _resultPage = result?.Page ?? 1;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _results = new();
            _resultTotal = 0;
            Toast.Error($"گەڕان سەرنەکەوت: {ex.Message}");
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Writes
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// One request per target. Sequential rather than parallel: they all write relations on the
    /// same word, and the server returns the word's refreshed state with each — firing them at
    /// once would race and leave the screen holding whichever reply landed last.
    /// </summary>
    async Task Add()
    {
        if (Blocker is not null || _word is null || SelectedType is null) return;

        _busy = true;
        var added = 0;
        var failures = new List<string>();

        try
        {
            foreach (var target in _picked.Values.ToList())
            {
                try
                {
                    var updated = await Relations.AddAsync(new AddRelationDto
                    {
                        FromWordId = _word.WordId,
                        ToWordId = target.Id,
                        TypeId = SelectedType.Id,
                        FromSenseId = NeedsSense ? _fromSenseId : null,
                        ToSenseId = NeedsSense ? TargetSense(target.Id) : null,
                    });

                    if (updated is not null) _word = updated;
                    added++;
                }
                catch (Exception ex)
                {
                    // One bad pair must not lose the other five. Collected and reported together.
                    failures.Add($"{target.Kurdish}: {ex.Message}");
                }
            }

            _picked.Clear();
            _targetSense.Clear();
            await LoadCoverage();

            if (added > 0) Toast.Success($"{Ku.N(added)} پەیوەندی زیادکرا");
            foreach (var f in failures.Take(3)) Toast.Error(f);
        }
        finally { _busy = false; }
    }

    async Task Remove(RelationEdgeDto rel)
    {
        if (_word is null) return;

        _busy = true;
        try
        {
            var updated = await Relations.RemoveAsync(rel, _word.WordId);
            if (updated is not null) _word = updated;

            await LoadCoverage();
            Toast.Success($"پەیوەندی «{rel.OtherWord}» لابرا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { _busy = false; }
    }

    // ═══════════════════════════════════════════════════════════════════════

    static int Percent(RelationCoverageDto c) =>
        c.TotalWords <= 0 ? 0 : (int)Math.Round(c.WordsWithRelations * 100.0 / c.TotalWords);

    string RowClass(RelationTargetDto r, bool blocked) =>
        "flex w-full items-center gap-2.5 border-b border-line-soft px-3 py-2 text-start transition-colors last:border-b-0 "
        + (blocked ? "opacity-40" : _picked.ContainsKey(r.Id) ? "bg-green-tint" : "hover:bg-page");

    static string InverseHint(RelationTypeDto t) => t.IsSymmetric
        ? $"«{t.NameKu}» دوولایەنە — هەردوو وشەکە هەمان شت دەخوێننەوە."
        : string.IsNullOrWhiteSpace(t.InverseNameKu)
            ? t.NameKu
            : $"وشەی مەبەست «{t.InverseNameKu}» دەبێت بۆ ئەم وشەیە.";

    static string RelTitle(RelationEdgeDto rel)
    {
        var parts = new List<string> { rel.TypeNameKu };

        if (rel.OwnSenseLabel is { Length: > 0 }) parts.Add(rel.OwnSenseLabel);
        if (rel.OtherSenseLabel is { Length: > 0 }) parts.Add($"← {rel.OtherSenseLabel}");
        if (rel.IsAutoInverse) parts.Add("(بەخۆکار)");

        return string.Join(" · ", parts);
    }
}

@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@implements IAsyncDisposable
@inject WordService WordSvc
@inject AuthService Auth
@inject ActivityStream Stream
@inject WorkQueueService Queue

<PageTitle>ژینزار</PageTitle>

<HatchDefs />

@* The dashboard, on the layout language of design-sample-2.

   Three blocks across the top, read right to left: what the dictionary looks like as a whole
   (the dial plus four tiles), what is wrong with it right now (the alert rail), and what to do
   about it (the queue, stated as progress). Then one tabbed surface at the bottom instead of
   the four half-empty cards that used to sit there.

   Everything below the fold is one section at a time on purpose. The previous version showed
   recent words, contributors and the week chart simultaneously, each in a box too small to be
   read; a tab rail gives any one of them the full width. *@

<TelerikScope>

<PageHeader Title="ژینزار" Subtitle="@Subtitle">
    <Actions>
        <a href="/station" class="btn-primary">
            <Icon Name="sparkle" Class="h-4 w-4" />
            دەستپێکردنی ستەیشن
        </a>
        <button @onclick="RefreshAsync" disabled="@_refreshing" class="btn-secondary">
            @(_refreshing ? "نوێدەبێتەوە…" : "نوێکردنەوە")
        </button>
    </Actions>
</PageHeader>

@if (_loading)
{
    <div class="space-y-4">
        <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
            <div class="skeleton h-96 rounded-card"></div>
            <div class="skeleton h-96 rounded-card"></div>
            <div class="skeleton h-96 rounded-card lg:col-span-2 xl:col-span-1"></div>
        </div>
        <div class="skeleton h-16 rounded-card"></div>
        <div class="skeleton h-72 rounded-card"></div>
    </div>
}
else if (_stats is null)
{
    <div class="card page-enter flex flex-col items-center gap-3 py-20 text-center">
        <span class="hatch h-12 w-12 rounded-full border border-line"></span>
        <p class="text-sm text-ink-1">پەیوەندی بە ڕاژەکارەوە نەکرا</p>
        <button @onclick="Load" class="btn-primary mt-1">هەوڵدانەوە</button>
    </div>
}
else
{
    <div class="page-enter space-y-4">

        @* ── Row 1 ───────────────────────────────────────────────────────
           THREE BALANCED COLUMNS, each a stack of cards.

           The previous version put the tall things in one column and the short things in
           another, so the short column ran out of content long before the tall one and left a
           band of empty page under it. CSS grid cannot reflow a card up into a gap the way a
           masonry layout would, so the balancing has to be done by choosing what goes where:
           one tall card and one short card per column, rather than all the tall ones together.

           Roughly: dial + tiles ≈ pace + alerts ≈ contributors + timer. *@
        <div class="grid items-start gap-4 lg:grid-cols-2 xl:grid-cols-3">

            @* ── Column 1: what the dictionary looks like ───────────────── *@
            <div class="flex flex-col gap-4">

                @* The dial is completeness, not a single table's coverage: a word counts as
                   done when it has a meaning, a class and a part of speech, which is what
                   "finished" means to the teachers. *@
                <HeroGauge Ratio="@Completeness"
                           Title="تەواوی فەرهەنگ"
                           Subtitle="وشە بە واتا و پۆل و جۆری وشەوە"
                           Caption="وشەکان تەواون"
                           Delta="@Ku.Delta(_stats.WordsAddedLast7Days)"
                           Icon="book" />

                <div class="grid gap-4 sm:grid-cols-2">
                    <SparkTile Label="وشەی تۆمارکراو" Value="@_stats.TotalWords" Unit="وشە"
                               Href="/words" Series="@WeekCounts" />

                    <SparkTile Label="واتای تۆمارکراو" Value="@_stats.TotalMeanings" Unit="واتا"
                               Href="/words" Ratio="@MeaningCoverage"
                               Footnote="@($"{Ku.P(MeaningCoverage)} وشەکان واتایان هەیە")" />

                    <SparkTile Label="پەیوەندی" Value="@_stats.TotalRelations"
                               Href="/relations" Ratio="@RelationCoverage"
                               State="@RelationState" Footnote="@RelationFootnote" />

                    <SparkTile Label="پۆلەکان" Value="@_stats.TotalCategories" Unit="پۆل"
                               Href="/taxonomy/manage" State="@CategoryState" Footnote="@CategoryFootnote" />
                </div>
            </div>

            @* ── Column 2: how fast, and what is wrong ──────────────────── *@
            <div class="flex flex-col gap-4">

                @* Beside the dial rather than under it: "how much is done" and "so when is it
                   finished" are the same question asked twice, and they belong at the same
                   height rather than one scrolling past the other. *@
                <PaceCard Pace="@_pace" />

                @* Rows appear because a threshold was crossed — a clean dictionary shows an
                   empty rail, not four green ticks. *@
                <section class="card flex flex-col">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="card-badge"><Icon Name="alert" Class="h-4 w-4" /></span>
                        <h2 class="card-title">ئاگادارییەکان</h2>
                        <span class="pill @(Alerts.Count == 0 ? "pill-ok" : "pill-warn") ms-auto">
                            <bdi>@Ku.N(Alerts.Count)</bdi> چالاک
                        </span>
                    </div>

                    @if (Alerts.Count == 0)
                    {
                        <div class="flex flex-1 flex-col items-center justify-center gap-2 py-8 text-center">
                            <Icon Name="check" Class="h-8 w-8 text-green" />
                            <p class="text-sm text-ink-1">هیچ ئاگادارییەک نییە</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var a in Alerts)
                            {
                                <a href="@a.Href" class="flex items-center gap-3 rounded-chip border border-line-soft bg-page p-3 transition-colors hover:border-green-soft">
                                    <span class="card-badge !h-7 !w-7"><Icon Name="@a.Icon" Class="h-3.5 w-3.5" /></span>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-sm text-ink-1">@a.Title</p>
                                        <p class="truncate text-11 text-ink-3">@a.Detail</p>
                                    </div>
                                    <span class="shrink-0 text-13 text-warn"><bdi>@Ku.N(a.Count)</bdi></span>
                                </a>
                            }
                        </div>
                    }
                </section>
            </div>

            @* ── Column 3: who is doing it ──────────────────────────────────
                   Last in the DOM, which in RTL puts it at the TOP LEFT.

                   Sorted by word count because the tier ladder is built on it and a list that
                   jumps around alphabetically hides the thing the tiers are for. Still not a
                   scoreboard: no rank number, no comparison between people, and the only
                   progress bar on a row measures YOUR distance to YOUR next tier. *@
            <div class="flex flex-col gap-4 lg:col-span-2 xl:col-span-1">

                <section class="card flex flex-col">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="card-badge card-badge-users"><Icon Name="users" Class="h-4 w-4" /></span>
                        <h2 class="card-title">وشەچنەکان</h2>
                        <span class="pill pill-users"><bdi>@Ku.N(_editors.Count)</bdi></span>
                        <AuthorizeView Roles="Admin">
                            <a href="/users" class="btn-secondary ms-auto !py-1.5 !text-11">
                                <Icon Name="plus" Class="h-3 w-3" />
                                نوێ
                            </a>
                        </AuthorizeView>
                    </div>

                    @if (_editors.Count == 0)
                    {
                        <div class="flex flex-1 flex-col items-center justify-center gap-2 py-8 text-center">
                            <span class="hatch h-12 w-12 rounded-full border border-line"></span>
                            <p class="text-sm text-ink-1">هێشتا وشەچنێک نییە</p>
                        </div>
                    }
                    else
                    {
                        @* EVERYONE, on the dashboard itself. No "see all" link: the point of this
                           card is that a وشەچن can look at the dashboard and see what the team is
                           doing, and a card that shows six of eleven and sends you elsewhere for
                           the rest answers a different question.

                           Two across where this column is full width, so the list does not become
                           a very long ribbon at lg. The column scrolls once it outgrows the space
                           beside it rather than stretching the row. *@
                        <div class="grid max-h-[520px] gap-2 overflow-y-auto pe-1 lg:grid-cols-2 xl:grid-cols-1">
                            @foreach (var u in RankedEditors)
                            {
                                <ContributorRow Contributor="@u" />
                            }
                        </div>
                    }
                </section>

                <SessionTimer />
            </div>
        </div>


        @* ── Row 2: the work queue ─────────────────────────────────────── *@
        <div class="flex items-center gap-2">
            <h2 class="card-title">کەمووکوڕی وشەکان</h2>
            <a href="/queue" class="btn-secondary ms-auto !py-1.5 !text-11">هەموو</a>
        </div>

        @if (_queue is null)
        {
            <div class="card flex flex-col items-center gap-2 py-8 text-center">
                <span class="hatch h-8 w-8 rounded-full border border-line"></span>
                <p class="text-sm text-ink-2">کەمووکوڕی وشەکان نەهاتەوە</p>
            </div>
        }
        else if (TopBuckets.Count == 0)
        {
            <div class="card flex flex-col items-center gap-2 py-8 text-center">
                <Icon Name="check" Class="h-8 w-8 text-green" />
                <p class="text-sm text-ink-1">هیچ کارێکی ماوە نییە</p>
            </div>
        }
        else
        {
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var b in TopBuckets)
                {
                    <ProgressCard Title="@b.Label" Subtitle="@b.Hint"
                                  Href="@($"/queue?bucket={(int)b.Bucket}")"
                                  Remaining="@b.Count" Total="@_stats.TotalMeanings"
                                  Configured="@b.IsConfigured" Icon="queue" />
                }
            </div>
        }

        @* ── Row 3: recent words and the week, side by side ────────────────
           These used to share a tab rail with the contributors. The rail is gone at the
           client's request: on a wide screen all of it fits without anything shrinking, and
           a dashboard whose sections you have to click to reach is one that gets read once. *@
        <div class="grid items-start gap-4 xl:grid-cols-12">

            @* min-w-0 is load-bearing, not tidiness. A grid item defaults to min-width:auto, so it
               refuses to shrink below its content — and the grid below is deliberately 750px wide.
               Without this the track grows to 750px, pushes <main> past the viewport, and the whole
               DOCUMENT scrolls sideways: in RTL that drags the page off to the left and leaves the
               cards clipped. With it the track shrinks and the grid scrolls inside itself instead. *@
            <section class="card min-w-0 xl:col-span-8">
                <div class="mb-4 flex items-center gap-2.5">
                    <span class="card-badge"><Icon Name="book" Class="h-4 w-4" /></span>
                    <h2 class="card-title">نوێترین وشەکان</h2>
                    <a href="/words" class="btn-secondary ms-auto !py-1.5 !text-11">
                        <Icon Name="plus" Class="h-3 w-3" />
                        وشەی نوێ
                    </a>
                </div>

                @* EVERY column carries an explicit Width, including the two that look like they
                   could flex. Telerik only turns on horizontal scrolling once all widths are
                   known; with even one column unsized it fits the table to the container instead
                   and squashes the rest, which on a phone crushes five columns into ~360px and
                   leaves nothing to pan. The widths total 750px, so narrow screens scroll and
                   wide ones distribute the slack across the columns. *@
                <TelerikGrid Data="@_stats.RecentWords" Sortable="true" Height="340px" Class="dash-grid">
                    <GridColumns>
                        <GridColumn Field="@nameof(RecentWordDto.Kurdish)" Title="وشە" Width="200px">
                            <Template>
                                @{ var w = (RecentWordDto)context; }
                                <div class="flex items-center gap-2.5">
                                    <span class="card-badge !h-7 !w-7 text-13">
                                        @(w.Kurdish.Length > 0 ? w.Kurdish[..1] : "؟")
                                    </span>
                                    <span class="font-medium text-ink-1">@w.Kurdish</span>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(RecentWordDto.SpeechPane)" Title="جۆری وشە" Width="150px">
                            <Template>
                                @{ var w = (RecentWordDto)context; }
                                @if (string.IsNullOrWhiteSpace(w.SpeechPane))
                                {
                                    <span class="pill pill-warn">دیارینەکراو</span>
                                }
                                else
                                {
                                    <span class="pill pill-muted">@w.SpeechPane</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(RecentWordDto.Category)" Title="پۆل" Width="150px">
                            <Template>
                                @{ var w = (RecentWordDto)context; }
                                <span class="text-ink-2">@(string.IsNullOrWhiteSpace(w.Category) ? "—" : w.Category)</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(RecentWordDto.MeaningCount)" Title="واتا" Width="90px">
                            <Template>
                                @{ var w = (RecentWordDto)context; }
                                <span class="pill @(w.MeaningCount > 0 ? "pill-ok" : "pill-danger")">
                                    <bdi>@Ku.N(w.MeaningCount)</bdi>
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(RecentWordDto.CreatedAt)" Title="زیادکرا" Width="160px">
                            <Template>
                                @{ var w = (RecentWordDto)context; }
                                <span class="text-ink-2">@Ago(w.CreatedAt)</span>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                    <NoDataTemplate>
                        <div class="flex flex-col items-center gap-3 py-10 text-center">
                            <span class="hatch h-12 w-12 rounded-full border border-line"></span>
                            <p class="text-sm text-ink-1">هێشتا هیچ وشەیەک نییە</p>
                        </div>
                    </NoDataTemplate>
                </TelerikGrid>
            </section>

            <section class="card min-w-0 xl:col-span-4">
                <div class="mb-4 flex items-center gap-2.5">
                    <span class="card-badge card-badge-chart"><Icon Name="chart" Class="h-4 w-4" /></span>
                    <h2 class="card-title">چالاکی هەفتانە</h2>
                    <span class="ms-auto text-xs text-ink-2">
                        <bdi>@Ku.Delta(_stats.WordsAddedLast7Days)</bdi> وشە
                    </span>
                </div>

                @* A week with no activity is an empty STATE, not an empty card: every bar is
                   hatched at a readable height so the row still reads as seven days.
                   The row must STRETCH, not end-align — with items-end each column shrinks to
                   its content, the flex-1 track gets no height, and every bar collapses. *@
                <div class="flex h-40 gap-2 sm:h-56 xl:h-72">
                    @foreach (var d in LastSevenDays)
                    {
                        <div class="flex min-w-0 flex-1 flex-col items-center gap-2">
                            <div class="relative flex w-full flex-1 items-end">
                                @if (d.Count > 0 && d.Count == PeakCount)
                                {
                                    @* Centred with inset-x-0 + mx-auto, not start-1/2 + a negative
                                       translate. `transform` is physical while `start` is logical,
                                       so that pairing centres in LTR and pushes the badge a full
                                       half-width off the bar in RTL — which is every screen here. *@
                                    <span class="absolute inset-x-0 -top-1 mx-auto w-fit rounded-chip px-1.5 py-0.5 text-11 text-white"
                                          style="background: var(--grad-chart);">
                                        <bdi>@Ku.N(d.Count)</bdi>
                                    </span>
                                }
                                @* Today is still in progress, so it is hatched rather than solid —
                                   grey would read as "disabled", hatch reads as "not yet". *@
                                @* Royal blue, from the client palette sheet: every bar that plots
                                   TIME is this colour. Green is reserved for completion, and a
                                   busy Tuesday is not an achievement — it is just a Tuesday. *@
                                <div class="w-full rounded-card @(IsSolid(d) ? "chart-bar" : "hatch border border-line")"
                                     style="height:@(BarHeight(d.Count))%"
                                     title="@d.Date.ToString("yyyy-MM-dd")"></div>
                            </div>
                            <span class="text-11 text-ink-3">@DayInitial(d.Date)</span>
                        </div>
                    }
                </div>
            </section>
        </div>

    </div>
}

</TelerikScope>

@code {
    DashboardDto? _stats;
    PaceDto? _pace;
    List<ContributorDto> _editors = new();
    bool _loading = true;
    bool _refreshing;
    DateTime? _updatedAt;

    /// <summary>
    /// Contributors, most work done first — written plus fixed.
    ///
    /// Ordered rather than alphabetical because the tier ladder is built on the word count, and
    /// a list that sorts by name scatters the tiers so the badges say nothing. Ordering is NOT
    /// a rank: no position number is shown, and a row never compares one person to another.
    /// </summary>
    List<ContributorDto> RankedEditors =>
        _editors.OrderByDescending(u => u.TotalContribution)
                .ThenByDescending(u => u.WordsUpdated)
                .ThenBy(u => u.UserName, StringComparer.Ordinal)
                .ToList();

    /// <summary>Something changed since this page loaded. Shown as a nudge, never auto-applied.</summary>
    bool _stale;

    /// <summary>Sits under the page title; carries the live-refresh time rather than a "زیندوو" badge.</summary>
    string Subtitle => _stale
        ? "ژمارەکان گۆڕاون — نوێی بکەرەوە"
        : _updatedAt is { } t
            ? $"دوایین نوێکردنەوە {Ku.Sub(t.ToString("HH:mm"))}"
            : "پوختەی فەرهەنگ و ئەو کارەی ماوە";

    // The dashboard aggregates work done by *other* editors, so it goes stale the moment someone else
    // saves. The backend pushes every committed write down the activity hub, so we hear about it
    // immediately — but we only mark the page stale, we do not re-pull. See OnActivityAsync.
    readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await Load();

        Stream.Received += OnActivityAsync;
        Stream.Reconnected += OnReconnectedAsync;
        await Stream.StartAsync();
    }

    /// <summary>
    /// A write happened somewhere. The dashboard does not re-pull itself for it — it just notes
    /// that the numbers on screen are behind, and the reader refreshes when they care.
    ///
    /// Live totals sound useful and mostly are not: the figures move every few seconds during a
    /// busy afternoon, the page re-renders under whoever is reading it, and every one of those
    /// re-pulls is a six-way aggregate. The notification bell still arrives instantly, because
    /// that one IS worth knowing about the moment it happens.
    /// </summary>
    Task OnActivityAsync(IReadOnlyList<AuditLogDto> entries)
    {
        _stale = true;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Pushes sent while the socket was down are gone for good, so the totals may be stale.</summary>
    Task OnReconnectedAsync()
    {
        _stale = true;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Re-pulls in place. Unlike <see cref="Load"/> it never raises the skeleton, so the numbers tick
    /// over under the user instead of the page collapsing to placeholders.
    /// </summary>
    async Task RefreshAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        StateHasChanged();

        try
        {
            var stats = await WordSvc.GetDashboardAsync();
            var editors = await Auth.GetLeaderboardAsync();
            var queue = await Queue.GetSummaryAsync(fresh: true);
            var pace = await WordSvc.GetPaceAsync();

            // Assigned together so a half-updated dashboard never renders.
            _stats = stats;
            _editors = editors;
            _queue = queue;
            _pace = pace;
            _updatedAt = DateTime.Now;
            _stale = false;
        }
        catch
        {
            // A failed poll keeps the last good numbers on screen rather than blanking the page.
        }
        finally
        {
            _refreshing = false;
            StateHasChanged();
        }
    }

    async Task Load()
    {
        _loading = true;
        try { _stats = await WordSvc.GetDashboardAsync(); }
        catch { _stats = null; }

        try { _editors = await Auth.GetLeaderboardAsync(); }
        catch { _editors = new(); }

        try { _queue = await Queue.GetSummaryAsync(); }
        catch { _queue = null; }

        try { _pace = await WordSvc.GetPaceAsync(); }
        catch { _pace = null; }

        _updatedAt = DateTime.Now;
        _loading = false;
    }

    public async ValueTask DisposeAsync()
    {
        Stream.Received -= OnActivityAsync;
        Stream.Reconnected -= OnReconnectedAsync;

        await _cts.CancelAsync();
        _cts.Dispose();
    }

    // ── Thresholds ──────────────────────────────────────────────────────────
    // Semantic colour is COMPUTED, never assigned per tile. Both of these encode a
    // defect the handoff calls out: an empty relations table, and category sprawl.

    /// <summary>26 → 79 in a month is the sprawl this warns about. Above it, the tile goes warn.</summary>
    const int CategoryBudget = 30;

    SparkTile.Tone RelationState =>
        _stats!.TotalRelations == 0 ? SparkTile.Tone.Danger : SparkTile.Tone.Normal;

    SparkTile.Tone CategoryState =>
        _stats!.TotalCategories > CategoryBudget ? SparkTile.Tone.Warn : SparkTile.Tone.Normal;

    string RelationFootnote => _stats!.TotalRelations == 0
        ? "هیچ وشەیەک پەیوەندی نییە"
        : $"{Ku.P(RelationCoverage)} وشەکان پەیوەندییان هەیە";

    string CategoryFootnote => _stats!.TotalCategories > CategoryBudget
        ? $"{Ku.N(_stats.TotalCategories - CategoryBudget)} زیاتر لە سنووری پێشنیارکراو"
        : "لە سنووردا";

    double MeaningCoverage => Ratio(_stats!.TotalWords - _stats.WordsWithoutMeanings, _stats.TotalWords);
    double RelationCoverage => Ratio(_stats!.TotalWords - _stats.WordsWithoutRelations, _stats.TotalWords);

    /// <summary>
    /// The dial. A word is "done" when it has a meaning, a class and a part of speech — the three
    /// things the station screen asks for. Relations are excluded on purpose: with an empty
    /// relations table they would peg the whole dictionary near zero and the dial would stop
    /// moving as people work, which is the one thing it has to do.
    ///
    /// Counted as the worst of the three rather than an average, so a gap cannot be hidden by
    /// two full columns.
    /// </summary>
    double Completeness
    {
        get
        {
            var total = _stats!.TotalWords;
            if (total <= 0) return 0;

            var worst = Math.Max(_stats.WordsWithoutMeanings,
                        Math.Max(_stats.WordsWithoutCategory, _stats.WordsWithoutSpeechPane));
            return Ratio(total - worst, total);
        }
    }

    static double Ratio(int part, int total) => total <= 0 ? 0 : Math.Clamp(part / (double)total, 0, 1);

    // ── Alerts ──────────────────────────────────────────────────────────────
    record Alert(string Title, string Detail, int Count, string Href, string Icon);

    /// <summary>
    /// Only real problems. A row exists because a count is non-zero or a budget was crossed, so
    /// an empty rail genuinely means there is nothing to look at — which is what makes the rail
    /// worth glancing at every morning.
    /// </summary>
    List<Alert> Alerts
    {
        get
        {
            if (_stats is null) return new();

            var list = new List<Alert>();

            if (_stats.WordsWithoutMeanings > 0)
                list.Add(new("وشە بەبێ واتا", "وشەی بەبێ هیچ واتایەک", _stats.WordsWithoutMeanings, "/words", "book"));

            if (_stats.WordsWithoutSpeechPane > 0)
                list.Add(new("وشە بەبێ جۆری وشە", "ناو، کردار… دیاری نەکراوە", _stats.WordsWithoutSpeechPane, "/queue", "tag"));

            if (_stats.WordsWithoutCategory > 0)
                list.Add(new("وشە بەبێ پۆل", "بواری بەکارهێنان دیاری نەکراوە", _stats.WordsWithoutCategory, "/taxonomy/manage", "tag"));

            if (_stats.TotalRelations == 0)
                list.Add(new("هیچ پەیوەندییەک نییە", "هاومانا و پێچەوانە بەتاڵن", _stats.TotalWords, "/relations", "relations"));
            else if (_stats.WordsWithoutRelations > 0)
                list.Add(new("وشە بەبێ پەیوەندی", "هاومانا یان پێچەوانەی نییە", _stats.WordsWithoutRelations, "/relations", "relations"));

            if (_stats.TotalCategories > CategoryBudget)
                list.Add(new("پۆلەکان زۆر بوون", $"سنووری پێشنیارکراو {Ku.Raw(CategoryBudget)}ە", _stats.TotalCategories, "/settings", "alert"));

            return list;
        }
    }

    // ── Weekly bars ─────────────────────────────────────────────────────────
    List<DailyCountDto> LastSevenDays =>
        _stats!.DailyAdded.OrderBy(d => d.Date).TakeLast(7).ToList();

    /// <summary>The same seven days, as bare counts for the tile sparkline.</summary>
    List<int> WeekCounts => LastSevenDays.Select(d => d.Count).ToList();

    int PeakCount => LastSevenDays.Count == 0 ? 0 : LastSevenDays.Max(d => d.Count);

    /// <summary>
    /// A zero day still shows a stub so the row reads as seven days rather than four. With no
    /// activity at all the whole week draws at a uniform low height, hatched.
    /// </summary>
    int BarHeight(int count) =>
        PeakCount <= 0 ? 18 : Math.Max(8, (int)Math.Round(count * 100.0 / PeakCount));

    /// <summary>
    /// Solid = finished and real. Today is still in progress and a zero day has nothing to show,
    /// so both hatch — grey would read as "disabled", hatch reads as "not yet".
    /// </summary>
    static bool IsSolid(DailyCountDto d) => d.Count > 0 && d.Date.Date != DateTime.Now.Date;

    static string DayInitial(DateTime d) => d.DayOfWeek switch
    {
        DayOfWeek.Saturday  => "ش",
        DayOfWeek.Sunday    => "ی",
        DayOfWeek.Monday    => "د",
        DayOfWeek.Tuesday   => "س",
        DayOfWeek.Wednesday => "چ",
        DayOfWeek.Thursday  => "پ",
        _                   => "ه",
    };

    // ── Work queue (پڕۆمپت ٦) ───────────────────────────────────────────────
    WorkQueueDto? _queue;

    /// <summary>
    /// The three cheapest buckets that still have work. Unconfigured buckets are kept rather than
    /// filtered out — they render as «ڕێکنەخراوە», because an unknown backlog is not an empty one
    /// and hiding it is how it stays unknown.
    /// </summary>
    List<WorkQueueBucketDto> TopBuckets =>
        _queue is null
            ? new()
            : _queue.Buckets.Where(b => !b.IsConfigured || b.Count > 0).Take(3).ToList();

    // ── Helpers ─────────────────────────────────────────────────────────────
    static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[..1].ToUpperInvariant();

    static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "ئێستا";
        if (span.TotalHours < 1) return $"{Ku.Raw((int)span.TotalMinutes)} خولەک لەمەوبەر";
        if (span.TotalDays < 1) return $"{Ku.Raw((int)span.TotalHours)} کاتژمێر لەمەوبەر";
        if (span.TotalDays < 30) return $"{Ku.Raw((int)span.TotalDays)} ڕۆژ لەمەوبەر";
        return Ku.Sub(utc.ToString("yyyy-MM-dd"));
    }
}

@page "/denied"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>ڕێگەپێنەدراو</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-page px-4">
    <div class="max-w-sm text-center">
        <span class="mb-5 inline-flex h-14 w-14 items-center justify-center rounded-card bg-warn-tint text-warn">
            <Icon Name="alert" Class="h-6 w-6" />
        </span>
        <h1 class="mb-2 text-20 font-medium text-ink-1">ڕێگەت پێنەدراوە</h1>
        <p class="mb-6 text-sm text-ink-2">
            ڕۆڵی هەژمارەکەت ڕێگەی پێنادات ئەم بەشە ببینێت. ئەگەر پێویستت پێیەتی، پەیوەندی بە بەڕێوەبەرەوە بکە.
        </p>
        <a href="/" class="btn-primary">گەڕانەوە بۆ داشبۆرد</a>
    </div>
</div>

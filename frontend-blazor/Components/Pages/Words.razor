@page "/words"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@implements IAsyncDisposable
@inject WordService WordSvc
@inject ActivityStream Stream
@inject Toast Toast
@inject TaxonomyAdminService Taxonomy

<PageTitle>وشەکان — ژینزار</PageTitle>

@* The word list, on a Telerik grid with a detail row.

   It used to be a stack of tall cards, each carrying the headword, every meaning, every
   relation and a description — beautiful for five words and unusable for three thousand,
   because no two rows lined up and you could not scan a column to find the gaps.

   So: one line per word, with the counts that matter as columns, and everything that used
   to make the card tall moved into a detail row you open when you actually want it. The
   grid is server-paged through OnRead — 3,026 words are never all in the circuit. *@

<TelerikScope>

<PageHeader Title="وشەکان" Subtitle="@($"{Ku.N(_totalCount)} وشە تۆمارکراوە")">
    <Actions>
        <TelerikButton OnClick="@OpenAdd" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Icon="@SvgIcon.Plus">
            وشەی نوێ
        </TelerikButton>
    </Actions>
</PageHeader>

@* ── Filters ──────────────────────────────────────────────────────────────
   Deliberately OUTSIDE the grid. Telerik's own filter row filters the page it was handed,
   and that page is twenty rows out of three thousand — on this data it would lie. Every
   control here goes to the server and rebinds.

   One row on desktop, stacked on a phone, and a summary line underneath that says what is
   currently applied with one click to clear it. A filter you cannot see is a filter you
   forget you set, and then the list is "broken".

   ONE flex row rather than two grids, because the cascade's length is data: a part of speech
   with one axis and one with six both have to look deliberate. Every field grows over a basis,
   so they divide the row evenly while it fits and wrap a field at a time when it does not — a
   fixed four-column grid would leave a two-axis row with two holes in it, and strand a seventh
   field alone on a second line. `basis-full` below sm stacks them on a phone.

   `grow`, not `flex-1`: the flex shorthand writes flex-basis too, which would quietly beat the
   `basis-*` beside it and collapse every field to the same zero basis. *@
<div class="mb-3 flex flex-wrap items-end gap-2">

    @* Widest field on the row: it holds a whole word, the others hold a label. *@
    <div class="relative min-w-0 grow-[2] basis-full sm:basis-64">
        @* Magnifier at the END — left, under RTL. Logical, so an LTR build mirrors it. *@
        <span class="pointer-events-none absolute end-3 top-1/2 -translate-y-1/2 text-ink-3">
            <Icon Name="search" Class="h-4 w-4" />
        </span>
        <input value="@_search" @oninput="OnSearchInput"
               placeholder="وشەکە بە پیتی سەرەتا بگەڕێ…"
               class="field pe-10" />
    </div>

    <div class="min-w-0 grow basis-full sm:basis-44">
        <TelerikDropDownList Data="@GapOptions" @bind-Value="_missing"
                             TextField="Label" ValueField="Key"
                             DefaultText="هەموو وشەکان" Width="100%"
                             OnChange="@(_ => Rebind())" />
    </div>

    @* ── The cascade: بەشی ئاخاوتن → تەوەر → نرخ → تەوەر → … ───────────────────
       Driven by the options tree, so it has NO FIXED DEPTH. Pick a part of speech and its
       top-level axes appear; answer one, and whatever sub-groups that answer opens appear
       beside it — جێناو → سەربەخۆ → کەسی is already three levels and nothing stops a fourth.

       The list is resolved on the SERVER by the same OptionsTree the entry form and the work
       queue use. That is the point: this screen used to build its own two-level cascade out of
       the assignment list, so it offered sub-groups as if they were top-level questions — تێپەڕی
       sitting beside بەشی ئاخاوتن with nothing saying it only applies to a تەواو verb — and it
       went stale the moment somebody added a level in ڕێکخستن. A second copy of the rule is a
       copy that will disagree.

       Steps that do not apply are ABSENT, never disabled: the station screen's rule too. *@
    @if (_partsOfSpeech.Any())
    {
        <div class="min-w-0 grow basis-full sm:basis-44">
            <TelerikDropDownList Data="@_partsOfSpeech" @bind-Value="_partOfSpeech"
                                 TextField="@nameof(TaxonomyPartOfSpeechDto.NameKu)"
                                 ValueField="@nameof(TaxonomyPartOfSpeechDto.Id)"
                                 DefaultText="بەشی ئاخاوتن" Width="100%"
                                 OnChange="@(_ => OnPartOfSpeechChanged())" />
        </div>

        @* Depth-first: every axis is immediately followed by the groups its answer opened, so one
           pass renders the whole tree. A nested group is captioned with the value it hangs off —
           without that, two groups opened by two different answers look like siblings.

           The caption sits ABOVE the control and the row is bottom-aligned, so a captioned field
           grows upward and every dropdown on the row still shares one baseline. *@
        @foreach (var ax in _filterAxes)
        {
            <div class="min-w-0 grow basis-full sm:basis-44">
                @if (ax.Depth > 0 && !string.IsNullOrWhiteSpace(ax.ParentValueName))
                {
                    <p class="mb-0.5 truncate text-11 text-ink-3" title="@($"{ax.ParentValueName} ← {ax.Name}")">
                        <span class="text-ink-2">@ax.ParentValueName</span> ←
                    </p>
                }
                @* The technical label, not Ask. The entry form prints the teacher's question
                   («کارەکە چ جۆرێکە؟») because it is asking; a filter bar is naming a column. *@
                <TelerikDropDownList Data="@ax.Values" TItem="StationValueDto" TValue="int"
                                     Value="@PickedOn(ax.AxisId)"
                                     ValueChanged="@((int v) => OnValuePicked(ax.AxisId, v))"
                                     TextField="@nameof(StationValueDto.Name)"
                                     ValueField="@nameof(StationValueDto.ValueId)"
                                     DefaultText="@ax.Name" Width="100%" />
            </div>
        }
    }
</div>

@if (_categories.Any())
{
    <div class="mb-3 flex flex-wrap gap-1.5">
        <button @onclick='() => SetCategory("")' class="@PillClass(_selectedCategory == "")">
            هەموو پۆلەکان
        </button>
        @foreach (var cat in _categories)
        {
            <button @onclick="() => SetCategory(cat.Name)" class="@PillClass(_selectedCategory == cat.Name)">
                @cat.Name <bdi class="text-11 opacity-70">@Ku.N(cat.WordCount)</bdi>
            </button>
        }
    </div>
}

@if (HasFilters)
{
    <div class="mb-3 flex flex-wrap items-center gap-2 rounded-chip border border-line-soft bg-page px-3 py-2">
        <span class="text-11 text-ink-3">پاڵاوتن:</span>

        @if (!string.IsNullOrWhiteSpace(_search))
        {
            <span class="pill pill-muted">دەستپێدەکات بە «@_search»</span>
        }
        @if (_partOfSpeech > 0)
        {
            <span class="pill pill-ok">@(_partsOfSpeech.FirstOrDefault(p => p.Id == _partOfSpeech)?.NameKu)</span>
        }
        @* One chip per level, in cascade order. A sub-answer read on its own is ambiguous — نێر
           means nothing without the ڕەگەز it answers — so each chip carries its axis. *@
        @foreach (var (axis, val) in PickedPairs())
        {
            <span class="pill pill-ok">@axis.Name: @val.Name</span>
        }
        @if (!string.IsNullOrWhiteSpace(_missing))
        {
            <span class="pill pill-warn">@(GapOptions.First(g => g.Key == _missing).Label)</span>
        }
        @if (!string.IsNullOrWhiteSpace(_selectedCategory))
        {
            <span class="pill pill-muted">@_selectedCategory</span>
        }

        <span class="ms-auto text-11 text-ink-2"><bdi>@Ku.N(_totalCount)</bdi> ئەنجام</span>

        <TelerikButton OnClick="@ClearFilters" Icon="@SvgIcon.Cancel"
                       FillMode="@ThemeConstants.Button.FillMode.Flat">
            سڕینەوەی پاڵاوتن
        </TelerikButton>
    </div>
}

<TelerikGrid @ref="_grid" TItem="WordDto" OnRead="@OnGridRead"
             Pageable="true" PageSize="20" Sortable="false">
    <GridColumns>
        <GridColumn Field="@nameof(WordDto.Kurdish)" Title="وشە" Width="260px">
            <Template>
                @{ var w = (WordDto)context; }
                <div class="flex items-center gap-2.5">
                    <span class="card-badge !h-7 !w-7 text-13">
                        @(w.Kurdish.Length > 0 ? w.Kurdish[..1] : "؟")
                    </span>
                    <div class="min-w-0">
                        <p class="truncate text-15 font-medium text-ink-1">@w.Kurdish</p>
                        @if (!string.IsNullOrWhiteSpace(w.Description))
                        {
                            <p class="truncate text-11 text-ink-3">@w.Description</p>
                        }
                    </div>
                </div>
            </Template>
        </GridColumn>

        <GridColumn Title="جۆری وشە" Width="180px">
            <Template>
                @{ var w = (WordDto)context; }
                @if (w.SpeechPanes.Count == 0)
                {
                    @* Missing, not empty. The whole point of the queue is that this is fixable
                       work, so it is marked rather than left as a blank cell. *@
                    <span class="pill pill-warn">دیارینەکراو</span>
                }
                else
                {
                    <div class="flex flex-wrap gap-1">
                        @foreach (var sp in w.SpeechPanes)
                        {
                            <span class="pill pill-ok">@sp.Kurdish</span>
                        }
                    </div>
                }
            </Template>
        </GridColumn>

        <GridColumn Title="پۆل" Width="200px">
            <Template>
                @{ var w = (WordDto)context; }
                @if (w.Categories.Count == 0)
                {
                    <span class="text-ink-3">—</span>
                }
                else
                {
                    <div class="flex flex-wrap gap-1">
                        @foreach (var cat in w.Categories)
                        {
                            <span class="pill pill-muted">@cat.Name</span>
                        }
                    </div>
                }
            </Template>
        </GridColumn>

        <GridColumn Title="واتا" Width="90px">
            <Template>
                @{ var w = (WordDto)context; }
                <span class="pill @(w.Meanings.Count > 0 ? "pill-ok" : "pill-danger")">
                    <bdi>@Ku.N(w.Meanings.Count)</bdi>
                </span>
            </Template>
        </GridColumn>

        <GridColumn Title="پەیوەندی" Width="110px">
            <Template>
                @{ var w = (WordDto)context; }
                @{ var n = w.OutgoingRelations.Count + w.IncomingRelations.Count; }
                <span class="pill @(n > 0 ? "pill-ok" : "pill-muted")">
                    <bdi>@Ku.N(n)</bdi>
                </span>
            </Template>
        </GridColumn>

        <GridColumn Title="" Width="120px">
            <Template>
                @{ var w = (WordDto)context; }
                <div class="flex items-center gap-1">
                    <TelerikButton OnClick="@(() => OpenEdit(w))" Icon="@SvgIcon.Pencil"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat" Title="دەستکاری" />
                    <TelerikButton OnClick="@(() => ConfirmDelete(w))" Icon="@SvgIcon.Trash"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Error" Title="سڕینەوە" />
                </div>
            </Template>
        </GridColumn>
    </GridColumns>

    @* Everything that used to make the card tall. Opened per row, so the scan stays a scan. *@
    <DetailTemplate>
        @{ var w = (WordDto)context; }
        <div class="space-y-3 bg-page p-4">
            <div>
                <p class="mb-1.5 text-11 text-ink-3">واتاکان</p>
                @if (w.Meanings.Count == 0)
                {
                    <p class="text-sm text-warn">هیچ واتایەکی نییە</p>
                }
                else
                {
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var m in w.Meanings)
                        {
                            <span class="inline-flex items-baseline gap-1 rounded-chip border border-line-soft bg-card px-2.5 py-1 text-xs leading-snug text-ink-2">
                                @if (!string.IsNullOrEmpty(m.Locate))
                                {
                                    <span class="shrink-0 text-11 text-ink-3">@m.Locate</span>
                                    <span class="text-11 text-ink-3">·</span>
                                }
                                <span>@m.Meaning</span>
                            </span>
                        }
                    </div>
                }
            </div>

            @{ var related = w.OutgoingRelations.Concat(w.IncomingRelations).ToList(); }
            @if (related.Any())
            {
                <div>
                    <p class="mb-1.5 text-11 text-ink-3">پەیوەندییەکان</p>
                    @* One chip style for every relation type. Seven colours here would be a
                       second palette; direction is carried by the arrow, type by the tooltip. *@
                    <div class="flex flex-wrap gap-1">
                        @foreach (var rw in related)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full border border-line bg-card px-2 py-0.5 text-11 text-ink-2"
                                  title="@RelLabel(rw.RelationType)">
                                <span class="text-ink-3">@(rw.IsIncoming ? "←" : "→")</span>
                                @rw.RelatedKurdish
                            </span>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(w.Description))
            {
                <div>
                    <p class="mb-1 text-11 text-ink-3">وەسف</p>
                    <p class="text-sm leading-relaxed text-ink-2">@w.Description</p>
                </div>
            }
        </div>
    </DetailTemplate>

    <NoDataTemplate>
        <div class="flex flex-col items-center gap-2 py-16 text-center">
            <span class="hatch h-12 w-12 rounded-full border border-line"></span>
            <p class="text-sm text-ink-1">هیچ وشەیەک نەدۆزرایەوە</p>
            <p class="text-xs text-ink-2">وشەی نوێ زیاد بکە</p>
        </div>
    </NoDataTemplate>
</TelerikGrid>

<WordFormModal IsVisible="_showModal"
               EditingWord="_editingWord"
               OnClose="CloseModal"
               OnSaved="OnSaved" />

<TelerikDialog Visible="@(_deletingWord is not null)" Title="سڕینەوەی وشە"
               VisibleChanged="@(async v => { if (!v) await CancelDelete(); })"
               ButtonsLayout="@DialogButtonsLayout.End" Width="420px">
    <DialogContent>
        <p class="text-sm leading-relaxed text-ink-2">
            وشەی <span class="font-medium text-ink-1">«@_deletingWord?.Kurdish»</span>
            دەسڕێتەوە و ناتوانرێت بگەڕێندرێتەوە.
        </p>
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="@CancelDelete">پاشگەز</TelerikButton>
        <TelerikButton OnClick="@ExecuteDelete" Enabled="@(!_deleting)"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error">
            @(_deleting ? "…" : "سڕینەوە")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

</TelerikScope>

@code {
    TelerikGrid<WordDto>? _grid;

    List<CategoryDto> _categories = new();
    int _totalCount;

    string _search = "";
    string _selectedCategory = "";

    string _missing = "";

    // ── The v3 cascade ──────────────────────────────────────────────────────
    TaxonomyOverviewDto? _taxonomy;
    List<TaxonomyPartOfSpeechDto> _partsOfSpeech = new();

    int _partOfSpeech;

    /// <summary>
    /// The questions that apply to the current answers, depth-first, resolved by the server's
    /// OptionsTree. Rebuilt on every pick — that is what makes the sub-groups appear and vanish.
    /// </summary>
    List<StationAxisDto> _filterAxes = new();

    /// <summary>
    /// axis id → the value chosen on it. One value per axis, deliberately: on a filter, two values
    /// on one axis would have to mean "holds both", and a word that is both تاک and کۆ is a
    /// question nobody is asking. Multi-select belongs on the entry form, where it records a fact.
    /// </summary>
    readonly Dictionary<int, int> _picked = new();

    int PickedOn(int axisId) => _picked.GetValueOrDefault(axisId);

    /// <summary>The chosen answers with the axis each belongs to, in cascade order, for the chips.</summary>
    IEnumerable<(StationAxisDto Axis, StationValueDto Value)> PickedPairs() =>
        _filterAxes
            .Select(a => (Axis: a, Value: a.Values.FirstOrDefault(v => v.ValueId == PickedOn(a.AxisId))))
            .Where(x => x.Value is not null)
            .Select(x => (x.Axis, x.Value!));

    /// <summary>The four gaps, worded as the thing that is missing rather than as a filter name.</summary>
    private record Gap(string Key, string Label);

    private static readonly Gap[] GapOptions =
    {
        new("meaning",  "بەبێ واتا"),
        new("pane",     "بەبێ جۆری وشە"),
        new("category", "بەبێ پۆل"),
        new("relation", "بەبێ پەیوەندی"),
    };

    bool HasFilters =>
        !string.IsNullOrWhiteSpace(_search) ||
        !string.IsNullOrWhiteSpace(_selectedCategory) ||
        !string.IsNullOrWhiteSpace(_missing) ||
        _partOfSpeech > 0 || _picked.Count > 0;

    bool _showModal;
    WordDto? _editingWord;
    WordDto? _deletingWord;
    bool _deleting;
    CancellationTokenSource? _searchCts;

    // ── Live updates ────────────────────────────────────────────────────────
    // The backend pushes every committed write down the activity hub, so a word another editor adds
    // shows up here on its own. Only rows this grid actually displays are worth reacting to.
    static readonly HashSet<string> GridEntities = new()
    {
        "Word", "WordMeans", "RelatedWord", "WordCategory", "WordSpeechPane", "Category",
    };

    static readonly TimeSpan Debounce = TimeSpan.FromMilliseconds(600);
    readonly CancellationTokenSource _cts = new();
    CancellationTokenSource? _liveDebounce;

    /// <summary>Set when a push landed while the editor was open — applied once it closes.</summary>
    bool _refreshPending;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();

        Stream.Received += OnActivityAsync;
        Stream.Reconnected += OnReconnectedAsync;
        await Stream.StartAsync();
    }

    /// <summary>
    /// The grid asks, we fetch. Page and size come from Telerik; search and category are page
    /// state, so any change to them has to go through <see cref="Rebind"/> rather than a reload.
    /// </summary>
    async Task OnGridRead(GridReadEventArgs args)
    {
        var page = args.Request.Page <= 0 ? 1 : args.Request.Page;
        var size = args.Request.PageSize <= 0 ? 20 : args.Request.PageSize;

        try
        {
            var result = await WordSvc.GetWordsAsync(
                page, size, _search, _selectedCategory,
                string.IsNullOrWhiteSpace(_missing) ? null : _missing,
                _partOfSpeech > 0 ? _partOfSpeech : null,
                axis: null,
                values: _picked.Values);
            args.Data = result?.Items ?? new List<WordDto>();
            args.Total = result?.TotalCount ?? 0;
            _totalCount = result?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            // An empty grid with no explanation is the failure mode people report as "it broke".
            args.Data = new List<WordDto>();
            args.Total = 0;
            Toast.Error($"وشەکان نەهاتنەوە: {ex.Message}");
        }
    }

    void Rebind() => _grid?.Rebind();

    Task OnActivityAsync(IReadOnlyList<AuditLogDto> entries)
    {
        if (entries.Any(e => GridEntities.Contains(e.EntityType)))
            ScheduleLiveRefresh();

        return Task.CompletedTask;
    }

    Task OnReconnectedAsync()
    {
        ScheduleLiveRefresh();
        return Task.CompletedTask;
    }

    void ScheduleLiveRefresh()
    {
        // Reloading under an open editor would swap the row out from beneath whoever is typing in it.
        // Hold the refresh and let CloseModal/CancelDelete apply it.
        if (_showModal || _deletingWord is not null)
        {
            _refreshPending = true;
            return;
        }

        // A bulk edit fires one push per row; collapse the burst into a single reload.
        _liveDebounce?.Cancel();
        _liveDebounce?.Dispose();
        _liveDebounce = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
        var token = _liveDebounce.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(Debounce, token);
                await InvokeAsync(async () =>
                {
                    await LoadCategories();
                    Rebind();
                });
            }
            catch (OperationCanceledException)
            {
                // Superseded by a newer push, or the page went away.
            }
        }, token);
    }

    public async ValueTask DisposeAsync()
    {
        Stream.Received -= OnActivityAsync;
        Stream.Reconnected -= OnReconnectedAsync;

        await _cts.CancelAsync();
        _cts.Dispose();
        _liveDebounce?.Dispose();
        _searchCts?.Dispose();
    }

    async Task LoadCategories()
    {
        try { _categories = await WordSvc.GetCategoriesAsync(); }
        catch { /* The filter pills are a convenience; the grid works without them. */ }

        try
        {
            _taxonomy = await Taxonomy.GetOverviewAsync();
            _partsOfSpeech = _taxonomy?.PartsOfSpeech.Where(p => p.IsActive).ToList() ?? new();

            // Settings are edited live, and this method also runs on a hub push. If the chosen part
            // of speech was deactivated out from under the filter, drop it rather than leave a
            // dropdown showing a part that is no longer offered.
            if (_partOfSpeech > 0 && _partsOfSpeech.All(p => p.Id != _partOfSpeech))
                _partOfSpeech = 0;

            // Re-resolve against the current tree: a group added, removed or re-parented in
            // ڕێکخستن changes which questions this filter should be asking.
            await ResolveAxes();
        }
        catch
        {
            // The cascade simply does not appear. The rest of the page is unaffected.
        }
    }

    /// <summary>
    /// Choosing a different part of speech invalidates every answer beneath it — those questions
    /// belong to the old part and may not even exist on the new one. Clearing them is not
    /// tidiness: a stale value id left in the query filters on something no dropdown on screen
    /// offers any more, and the empty result reads as the filter being broken.
    /// </summary>
    async Task OnPartOfSpeechChanged()
    {
        _picked.Clear();
        await ResolveAxes();
        Rebind();
    }

    /// <summary>
    /// One pick. Re-resolving is what opens the sub-group the answer unlocks — and closes the one
    /// the previous answer had opened.
    /// </summary>
    async Task OnValuePicked(int axisId, int valueId)
    {
        if (valueId > 0) _picked[axisId] = valueId;
        else _picked.Remove(axisId);

        await ResolveAxes();
        Rebind();
    }

    /// <summary>
    /// Asks the server which questions apply to the answers held right now, then drops answers to
    /// questions that are no longer being asked.
    ///
    /// The pruning is the part that matters. Resolve() walks down from the roots, so a stale
    /// answer can never bring a hidden group back on screen — but it would still be sent to the
    /// API and would still narrow the list, invisibly. One pass is enough: an axis is only
    /// reachable through its parent, so hiding a level hides everything under it at the same time.
    /// </summary>
    async Task ResolveAxes()
    {
        if (_partOfSpeech <= 0)
        {
            _filterAxes = new();
            _picked.Clear();
            return;
        }

        try
        {
            _filterAxes = await Taxonomy.PreviewFormAsync(_partOfSpeech, _picked.Values.ToList());
        }
        catch
        {
            // The cascade folds away and the rest of the page carries on. Keeping the picks while
            // their dropdowns are gone would filter on answers nobody can see or clear.
            _filterAxes = new();
            _picked.Clear();
            return;
        }

        var visible = _filterAxes.Select(a => a.AxisId).ToHashSet();
        foreach (var stale in _picked.Keys.Where(id => !visible.Contains(id)).ToList())
            _picked.Remove(stale);
    }

    void ClearFilters()
    {
        _search = "";
        _selectedCategory = "";
        _missing = "";
        _partOfSpeech = 0;
        _picked.Clear();
        _filterAxes = new();
        Rebind();
    }

    async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(350, _searchCts.Token);
            Rebind();
        }
        catch (TaskCanceledException) { }
    }

    void SetCategory(string cat)
    {
        _selectedCategory = cat;
        Rebind();
    }

    void OpenAdd() { _editingWord = null; _showModal = true; }
    void OpenEdit(WordDto w) { _editingWord = w; _showModal = true; }

    async Task CloseModal()
    {
        _showModal = false;
        await ApplyPendingRefresh();
    }

    /// <summary>Runs the reload that was held back while the editor had the screen.</summary>
    async Task ApplyPendingRefresh()
    {
        if (!_refreshPending) return;
        _refreshPending = false;

        await LoadCategories();
        Rebind();
    }

    async Task OnSaved()
    {
        _showModal = false;
        // This reload subsumes anything the hub pushed while the editor was open.
        _refreshPending = false;
        await LoadCategories();
        Rebind();
        Toast.Success("وشەکە پاشەکەوت کرا");
    }

    void ConfirmDelete(WordDto w) => _deletingWord = w;

    async Task CancelDelete()
    {
        _deletingWord = null;
        await ApplyPendingRefresh();
    }

    async Task ExecuteDelete()
    {
        if (_deletingWord is null) return;

        var name = _deletingWord.Kurdish;
        _deleting = true;

        try
        {
            await WordSvc.DeleteWordAsync(_deletingWord.Id);
            Toast.Success($"«{name}» سڕایەوە");
        }
        catch (Exception ex)
        {
            Toast.Error($"نەسڕایەوە: {ex.Message}");
        }
        finally
        {
            _deletingWord = null;
            _deleting = false;
            _refreshPending = false;
        }

        await LoadCategories();
        Rebind();
    }

    static string PillClass(bool active) => active
        ? "rounded-full bg-green-deep px-3 py-1 text-11 font-medium text-white"
        : "rounded-full border border-line bg-card px-3 py-1 text-11 text-ink-2 transition-colors hover:bg-page";

    static string RelLabel(string type) => type switch
    {
        "synonym"    => "هاومانا",
        "antonym"    => "دژەوشە",
        "related"    => "پەیوەندیدار",
        "example"    => "نموونە",
        "usage"      => "بەکارهێنان",
        "contextual" => "چوارچێوەیی",
        "partof"     => "بەشێکە لە",
        _            => type,
    };
}

@page "/users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@inject AuthService Auth
@inject NavigationManager Nav
@inject Toast Toast

<PageTitle>بەکارهێنەران — ژینزار</PageTitle>

@* The roster, on a grid.

   Fifteen people fit on a card wall; the card wall stopped being readable the moment anyone
   wanted to answer "who has admin" or "who has not logged in since March". A grid answers
   both by sorting a column.

   The two banners that used to sit above the list are gone — results go through the toast,
   which is the same channel every other screen uses and which does not push the content down
   the page every time you save. *@

<TelerikScope>

<PageHeader Title="بەکارهێنەران" Subtitle="@Subtitle">
    <Actions>
        <TelerikButton OnClick="@OpenCreate" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Icon="@SvgIcon.Plus">
            بەکارهێنەری نوێ
        </TelerikButton>
    </Actions>
</PageHeader>

<TelerikGrid Data="@_users" Sortable="true" Pageable="@(_users.Count > 20)" PageSize="20">
    <GridColumns>
        <GridColumn Field="@nameof(UserDto.UserName)" Title="بەکارهێنەر" Width="280px">
            <Template>
                @{ var u = (UserDto)context; }
                <div class="flex items-center gap-3">
                    @* Every fallback is the same tint. Per-user colour coding is banned: it turns
                       a roster of colleagues into a colour-keyed scoreboard. A photograph is the
                       person's own choice and is not the app assigning them a colour. *@
                    <Avatar Url="@u.AvatarUrl" Name="@(u.FullName ?? u.UserName)" Size="36" />
                    <div class="min-w-0">
                        <p class="truncate text-sm font-medium text-ink-1">
                            @(string.IsNullOrWhiteSpace(u.FullName) ? u.UserName : u.FullName)
                        </p>
                        <p class="truncate text-11 text-ink-3"><bdi>@u.Email</bdi></p>
                    </div>
                </div>
            </Template>
        </GridColumn>

        <GridColumn Title="ڕۆڵ" Width="220px">
            <Template>
                @{ var u = (UserDto)context; }
                <div class="flex flex-wrap gap-1">
                    @foreach (var role in u.Roles)
                    {
                        <span class="pill @RoleStyle(role)">@RoleLabel(role)</span>
                    }
                </div>
            </Template>
        </GridColumn>

        <GridColumn Field="@nameof(UserDto.IsActive)" Title="دۆخ" Width="120px">
            <Template>
                @{ var u = (UserDto)context; }
                @if (u.IsActive)
                {
                    <span class="pill pill-ok">چالاک</span>
                }
                else
                {
                    <span class="pill pill-danger">ڕاگیراو</span>
                }
            </Template>
        </GridColumn>

        <GridColumn Field="@nameof(UserDto.WordCount)" Title="وشەکان" Width="110px">
            <Template>
                @{ var u = (UserDto)context; }
                <bdi class="text-ink-1">@Ku.N(u.WordCount)</bdi>
            </Template>
        </GridColumn>

        <GridColumn Field="@nameof(UserDto.LastLoginAt)" Title="دوا چوونەژوورەوە" Width="170px">
            <Template>
                @{ var u = (UserDto)context; }
                <span class="@(u.LastLoginAt is null ? "text-ink-3" : "text-ink-2")">
                    @(u.LastLoginAt is { } at ? Ku.Sub(at.ToLocalTime().ToString("yyyy-MM-dd")) : "هەرگیز")
                </span>
            </Template>
        </GridColumn>

        <GridColumn Title="" Width="120px">
            <Template>
                @{ var u = (UserDto)context; }
                <div class="flex items-center gap-1">
                    <TelerikButton OnClick="@(() => OpenEdit(u))" Icon="@SvgIcon.Pencil"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat" Title="دەستکاری" />
                    <TelerikButton OnClick="@(() => ConfirmDelete(u))" Icon="@SvgIcon.Trash"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Error" Title="سڕینەوە" />
                </div>
            </Template>
        </GridColumn>
    </GridColumns>

    <NoDataTemplate>
        <div class="flex flex-col items-center gap-2 py-16 text-center">
            <span class="hatch h-12 w-12 rounded-full border border-line"></span>
            <p class="text-sm text-ink-1">@(_loading ? "دەهێنرێت…" : "هیچ بەکارهێنەرێک نییە")</p>
        </div>
    </NoDataTemplate>
</TelerikGrid>

@* ── Create / edit ────────────────────────────────────────────────────────
   One dialog for both. The only structural difference is that a username cannot be changed
   after creation and a password is optional on edit, which is two @if blocks, not two forms. *@
<TelerikDialog Visible="@(_editing is not null)"
               VisibleChanged="@(v => { if (!v) CloseModal(); })"
               Title="@(_isNew ? "بەکارهێنەری نوێ" : $"دەستکاری {_editing?.UserName}")"
               ButtonsLayout="@DialogButtonsLayout.End" Width="460px">
    <DialogContent>
        @if (_editing is not null)
        {
            <div class="space-y-4 text-start">

                @if (!_isNew)
                {
                    @* Only on edit. A new user has no row yet, so there is nothing to attach a
                       file to — the picture is set on the second pass, after Save. *@
                    <div class="flex items-center gap-4 rounded-chip border border-line-soft bg-page p-3">
                        <Avatar Url="@_editingAvatarUrl" Name="@_editing.UserName" Size="56" />

                        <div class="min-w-0 flex-1">
                            <p class="mb-2 text-11 text-ink-3">
                                JPG، PNG یان WEBP — زۆرترین قەبارە <bdi>5</bdi> مێگابایت
                            </p>
                            <div class="flex flex-wrap items-center gap-2">
                                <TelerikFileSelect Multiple="false"
                                                   AllowedExtensions="@AllowedExtensions"
                                                   MaxFileSize="@MaxAvatarBytes"
                                                   OnSelect="@OnAvatarSelected"
                                                   Enabled="@(!_uploadingAvatar)" />

                                @if (!string.IsNullOrWhiteSpace(_editingAvatarUrl))
                                {
                                    <TelerikButton OnClick="@RemoveUserAvatar" Enabled="@(!_uploadingAvatar)"
                                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                                   Icon="@SvgIcon.Trash" />
                                }
                            </div>
                            @if (_uploadingAvatar)
                            {
                                <p class="mt-1.5 text-11 text-ink-2">وێنەکە دەنێردرێت…</p>
                            }
                        </div>
                    </div>
                }

                @if (_isNew)
                {
                    <label class="block">
                        <span class="field-label">ناوی بەکارهێنەر</span>
                        <input @bind="_editing.UserName" placeholder="ahmadaziz" class="field" />
                    </label>
                }

                <label class="block">
                    <span class="field-label">ئیمەیل</span>
                    <input @bind="_editing.Email" type="email" class="field" />
                </label>

                <label class="block">
                    <span class="field-label">ناوی تەواو</span>
                    <input @bind="_editing.FullName" class="field" />
                </label>

                <label class="block">
                    <span class="field-label">
                        @(_isNew ? "وشەی نهێنی" : "وشەی نهێنی نوێ (بەتاڵی بهێڵەوە بۆ نەگۆڕین)")
                    </span>
                    <input @bind="_editing.Password" type="text" placeholder="@(_isNew ? "" : "نەگۆڕدراو")" class="field" />
                </label>

                <div>
                    <span class="field-label">ڕۆڵەکان</span>
                    @* Selected/unselected, not a colour per role — the label carries the meaning. *@
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var role in AllRoles)
                        {
                            var selected = _editing.Roles.Contains(role);
                            <button type="button" @onclick="() => ToggleRole(role)"
                                    class="@(selected
                                             ? "rounded-full bg-green-deep px-3 py-1.5 text-xs font-medium text-white"
                                             : "rounded-full border border-line bg-card px-3 py-1.5 text-xs text-ink-2 transition-colors hover:bg-page")">
                                @RoleLabel(role)
                            </button>
                        }
                    </div>
                </div>

                @if (!_isNew)
                {
                    <label class="flex cursor-pointer items-center gap-2">
                        <input type="checkbox" @bind="_editing.IsActive"
                               class="h-4 w-4 rounded border-line text-green-deep focus:ring-green" />
                        <span class="text-sm text-ink-1">هەژمار چالاکە</span>
                    </label>
                }
            </div>
        }
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="@CloseModal" Enabled="@(!_saving)">پاشگەزبوونەوە</TelerikButton>
        <TelerikButton OnClick="@SaveAsync" Enabled="@(!_saving)"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">
            @(_saving ? "پاشەکەوت دەکرێت…" : "پاشەکەوتکردن")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Delete confirmation ──────────────────────────────────────────────── *@
<TelerikDialog Visible="@(_deleting is not null)" Title="@($"سڕینەوەی {_deleting?.UserName}؟")"
               VisibleChanged="@(v => { if (!v) _deleting = null; })"
               ButtonsLayout="@DialogButtonsLayout.End" Width="420px">
    <DialogContent>
        <p class="text-sm leading-relaxed text-ink-2">
            وشەکانی ناسڕدرێنەوە — تەنها بێ خاوەن دەبن. ئەم کردارە ناگەڕێتەوە.
        </p>
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="@(() => _deleting = null)" Enabled="@(!_saving)">پاشگەزبوونەوە</TelerikButton>
        <TelerikButton OnClick="@DeleteAsync" Enabled="@(!_saving)"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error">
            بەڵێ، بیسڕەوە
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

</TelerikScope>

@code {
    // Every real role, not a subset.
    //
    // This list used to omit LinguisticOwner, which was not a cosmetic gap: SyncRolesAsync
    // replaces a user's roles with exactly what the form submits, so opening any user and
    // pressing save silently STRIPPED a role the picker could not show. The seeded admin lost
    // the role that way and the settings page then refused every write with "no permission" —
    // with nothing on screen to explain why.
    //
    // Anything that can be revoked here must therefore also be grantable here.
    private static readonly string[] AllRoles = { "Admin", "Editor", "Viewer", "LinguisticOwner" };

    private List<UserDto> _users = new();
    private bool _loading = true;
    private bool _saving;

    private EditModel? _editing;
    private bool _isNew;
    private UserDto? _deleting;

    /// <summary>Current picture of the user in the dialog. Updated in place after an upload.</summary>
    private string? _editingAvatarUrl;
    private bool _uploadingAvatar;

    private const int MaxAvatarBytes = 5 * 1024 * 1024;
    private static readonly List<string> AllowedExtensions = new() { ".jpg", ".jpeg", ".png", ".webp" };

    private string Subtitle => _loading
        ? "بەڕێوەبردنی هەژمار، ڕۆڵ و دەستڕاگەیشتن"
        : $"{Ku.N(_users.Count)} هەژمار · {Ku.N(_users.Count(u => u.IsActive))} چالاک";

    /// <summary>Backs both the create and the edit form; Password is optional when editing.</summary>
    private sealed class EditModel
    {
        public Guid Id { get; set; }
        public string UserName { get; set; } = "";
        public string Email { get; set; } = "";
        public string? FullName { get; set; }
        public string Password { get; set; } = "";
        public bool IsActive { get; set; } = true;
        public List<string> Roles { get; set; } = new();
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _users = await Auth.GetUsersAsync();
        }
        catch (ApiUnauthorizedException)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        catch (HttpRequestException)
        {
            Toast.Error("ناتوانرێت لیستی بەکارهێنەران بهێنرێت");
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreate()
    {
        _isNew = true;
        _editingAvatarUrl = null;
        _editing = new EditModel { Roles = { "Editor" } };
    }

    private void OpenEdit(UserDto user)
    {
        _isNew = false;
        _editingAvatarUrl = user.AvatarUrl;
        _editing = new EditModel
        {
            Id = user.Id,
            UserName = user.UserName,
            Email = user.Email ?? "",
            FullName = user.FullName,
            IsActive = user.IsActive,
            Roles = new List<string>(user.Roles),
        };
    }

    private void CloseModal() => _editing = null;

    private void ToggleRole(string role)
    {
        if (_editing is null) return;

        if (!_editing.Roles.Remove(role))
            _editing.Roles.Add(role);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;

        _saving = true;

        try
        {
            AuthResultDto result;

            if (_isNew)
            {
                result = await Auth.CreateUserAsync(new CreateUserDto
                {
                    UserName = _editing.UserName.Trim(),
                    Email = _editing.Email.Trim(),
                    FullName = _editing.FullName,
                    Password = _editing.Password,
                    Roles = _editing.Roles,
                });
            }
            else
            {
                result = await Auth.UpdateUserAsync(_editing.Id, new UpdateUserDto
                {
                    Email = _editing.Email.Trim(),
                    FullName = _editing.FullName,
                    IsActive = _editing.IsActive,
                    Roles = _editing.Roles,
                    NewPassword = string.IsNullOrWhiteSpace(_editing.Password) ? null : _editing.Password,
                });
            }

            if (!result.Succeeded)
            {
                // The dialog stays open on failure: the reason is almost always something in the
                // form ("that username is taken", "password too short") and closing it would throw
                // away everything the admin just typed.
                Toast.Error(result.Error ?? "پاشەکەوتکردن سەرکەوتوو نەبوو");
                return;
            }

            Toast.Success(_isNew ? "بەکارهێنەر دروستکرا" : "بەکارهێنەر نوێکرایەوە");
            _editing = null;
            await LoadAsync();
        }
        catch (ApiUnauthorizedException)
        {
            Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            Toast.Error("ناتوانرێت پەیوەندی بە سێرڤەرەوە بکرێت");
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Uploads immediately rather than on Save.
    ///
    /// A file cannot sit in a form field waiting for a submit — it would have to be held in the
    /// circuit's memory until the admin pressed a button they might never press. Uploading on
    /// select also means the preview above is the real stored image, not a client-side guess at
    /// what the server will produce after cropping and re-encoding.
    /// </summary>
    private async Task OnAvatarSelected(FileSelectEventArgs args)
    {
        var file = args.Files.FirstOrDefault();
        if (file is null || _editing is null) return;

        if (file.Size > MaxAvatarBytes)
        {
            Toast.Error("وێنەکە زۆر گەورەیە — زۆرترین قەبارە ٥ مێگابایتە.");
            return;
        }

        _uploadingAvatar = true;

        try
        {
            await using var stream = file.Stream;
            var result = await Auth.UploadUserAvatarAsync(_editing.Id, stream, file.Name);

            if (!result.Succeeded)
            {
                Toast.Error(result.Error ?? "ناردنی وێنە سەرکەوتوو نەبوو");
                return;
            }

            _editingAvatarUrl = result.User?.AvatarUrl;
            Toast.Success("وێنەکە پاشەکەوتکرا");

            // The grid behind the dialog still shows the old picture.
            await LoadAsync();
        }
        catch (ApiUnauthorizedException)
        {
            Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Toast.Error($"ناردنی وێنە سەرکەوتوو نەبوو: {ex.Message}");
        }
        finally
        {
            _uploadingAvatar = false;
        }
    }

    private async Task RemoveUserAvatar()
    {
        if (_editing is null) return;
        _uploadingAvatar = true;

        try
        {
            var result = await Auth.RemoveUserAvatarAsync(_editing.Id);

            if (!result.Succeeded)
            {
                Toast.Error(result.Error ?? "لابردنی وێنە سەرکەوتوو نەبوو");
                return;
            }

            _editingAvatarUrl = null;
            Toast.Success("وێنەکە لابرا");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"لابردنی وێنە سەرکەوتوو نەبوو: {ex.Message}");
        }
        finally
        {
            _uploadingAvatar = false;
        }
    }

    private void ConfirmDelete(UserDto user) => _deleting = user;

    private async Task DeleteAsync()
    {
        if (_deleting is null) return;

        var name = _deleting.UserName;
        _saving = true;

        try
        {
            var result = await Auth.DeleteUserAsync(_deleting.Id);

            // Checked on Succeeded, not on Error: a refusal does not always carry a message, and
            // Toast.Result would read a null Error as "it worked".
            if (result.Succeeded) Toast.Success($"«{name}» سڕدرایەوە");
            else Toast.Error(result.Error ?? "سڕینەوە سەرکەوتوو نەبوو");

            _deleting = null;
            await LoadAsync();
        }
        catch (ApiUnauthorizedException)
        {
            Nav.NavigateTo("/login", forceLoad: true);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string Initials(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[..1].ToUpperInvariant();

    /// <summary>
    /// Role, not identity, carries colour — and only one role does. Admin is the elevated
    /// permission worth spotting in a list; the rest are neutral.
    /// </summary>
    private static string RoleStyle(string role) => role switch
    {
        "Admin" or "LinguisticOwner" => "pill-ok",
        _ => "pill-muted",
    };

    private static string RoleLabel(string role) => role switch
    {
        "Admin" => "بەڕێوەبەر",
        "Editor" => "وشەچن",
        "Viewer" => "بینەر",
        "LinguisticOwner" => "خاوەنی زمانەوانی",
        _ => role,
    };
}

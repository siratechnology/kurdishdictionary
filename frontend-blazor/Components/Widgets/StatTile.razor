@* One headline number, for the secondary metric rows on Analytics and Users.

   The dashboard's four hero-row cards are MetricCard — this is the smaller sibling and has no
   states: a tile that needs a warn or danger colour is a MetricCard. *@

<div class="card">
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <p class="truncate text-13 text-ink-2">@Label</p>
            <p class="mt-1 text-28 font-medium text-ink-1"><bdi>@Value</bdi></p>
            @if (!string.IsNullOrEmpty(Hint))
            {
                <p class="mt-0.5 truncate text-xs text-ink-3">@Hint</p>
            }
        </div>

        @if (!string.IsNullOrEmpty(IconName))
        {
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-chip bg-green-tint text-on-tint">
                <Icon Name="@IconName" Class="h-[18px] w-[18px]" />
            </span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Preformatted — pass Ku.N(x) so the digits are Arabic-Indic.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    /// <summary>An Icon component name. Named IconName, not Icon, so it cannot shadow the component.</summary>
    [Parameter] public string IconName { get; set; } = "";

    [Parameter] public string? Hint { get; set; }
}

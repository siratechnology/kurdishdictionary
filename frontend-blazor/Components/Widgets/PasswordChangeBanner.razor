@* Seeded accounts ship with a password that is written down in the repo. Nag until it is replaced. *@

<AuthorizeView>
    @if (context.User.FindFirst("mustChangePassword")?.Value == "True")
    {
        <div class="mb-5 flex flex-wrap items-center gap-3 rounded-card border border-line bg-warn-tint px-4 py-3">
            <Icon Name="alert" Class="h-5 w-5 shrink-0 text-warn" />
            <p class="flex-1 text-sm text-ink-1">
                <span class="font-medium">وشەی نهێنیت بگۆڕە.</span>
                ئەم هەژمارە هێشتا وشەی نهێنی سەرەتایی بەکاردەهێنێت.
            </p>
            <a href="/profile" class="btn-primary">گۆڕینی وشەی نهێنی</a>
        </div>
    }
</AuthorizeView>

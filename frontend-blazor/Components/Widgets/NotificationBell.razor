@implements IAsyncDisposable
@inject ActivityService Activity
@inject ActivityStream Stream
@inject NavigationManager Nav

@* Live feed of what everyone is doing, pushed from the backend's activity hub the instant a write
   commits. The one poll left is the catch-up after a reconnect: SignalR does not replay what it
   dropped, so the gap has to be closed by asking for everything after the last id we hold. *@

<div class="relative">
    <button type="button" @onclick="Toggle" class="btn-topbar-icon" aria-label="ئاگادارکردنەوەکان">
        <Icon Name="bell" Class="h-[18px] w-[18px]" />

        @* A dot, never a number — the reference counts nothing in the top bar. *@
        @if (_unseen > 0)
        {
            <span class="absolute end-2 top-2 h-1.5 w-1.5 rounded-full bg-green"></span>
        }
    </button>

    @if (_open)
    {
        @* Click-away backdrop. *@
        <div class="fixed inset-0 z-30" @onclick="Close"></div>

        @* end-0 = the LEFT edge in RTL, so the panel hangs inward from the bell. *@
        <div class="absolute end-0 z-40 mt-2 w-80 overflow-hidden rounded-card border border-line bg-card shadow-shell">
            <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
                <p class="text-sm font-medium text-ink-1">ئاگادارکردنەوەکان</p>
                <a href="/activity" @onclick="Close" class="text-xs text-green hover:underline">
                    بینینی هەموو
                </a>
            </div>

            <div class="max-h-96 overflow-y-auto">
                @if (_items.Count == 0)
                {
                    <p class="px-4 py-8 text-center text-sm text-ink-3">هیچ چالاکییەک نییە</p>
                }
                else
                {
                    @foreach (var item in _items)
                    {
                        <div class="flex gap-3 border-b border-line px-4 py-3 last:border-0 hover:bg-page">
                            <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full @ActionStyle(item.Action)">
                                <Icon Name="@ActionIcon(item.Action)" Class="h-3.5 w-3.5" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs leading-snug text-ink-2">
                                    <span class="font-medium text-ink-1">@(item.UserName ?? "نەناسراو")</span>
                                    @ActionText(item.Action)
                                    <span class="font-medium text-ink-1">@(item.Summary ?? EntityLabel(item.EntityType))</span>
                                </p>
                                <p class="mt-0.5 text-11 text-ink-3">@Ago(item.CreatedAt)</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly List<AuditLogDto> _items = new();
    private int _lastSeenId;
    private int _unseen;
    private bool _open;

    protected override async Task OnInitializedAsync()
    {
        await PollAsync();

        // Everything already in the log at first load is history, not news.
        _unseen = 0;

        Stream.Received += OnActivityAsync;
        Stream.Reconnected += OnReconnectedAsync;
        await Stream.StartAsync();
    }

    /// <summary>A batch straight off the hub — no round-trip needed, the rows are already here.</summary>
    private async Task OnActivityAsync(IReadOnlyList<AuditLogDto> entries)
    {
        await InvokeAsync(() =>
        {
            // The catch-up poll and the push can overlap on the same rows; ids settle it.
            var fresh = entries.Where(e => e.Id > _lastSeenId)
                               .OrderByDescending(e => e.Id)
                               .ToList();
            if (fresh.Count == 0) return;

            Merge(fresh);
            StateHasChanged();
        });
    }

    private async Task OnReconnectedAsync() => await InvokeAsync(PollAndRenderAsync);

    private async Task PollAndRenderAsync()
    {
        await PollAsync();
        StateHasChanged();
    }

    /// <summary>Newest on top, capped at 30 — the bell is a glance, the full list lives at /activity.</summary>
    private void Merge(List<AuditLogDto> fresh)
    {
        _items.InsertRange(0, fresh);
        if (_items.Count > 30) _items.RemoveRange(30, _items.Count - 30);

        _unseen += fresh.Count;
        _lastSeenId = fresh.Max(f => f.Id);
    }

    private async Task PollAsync()
    {
        try
        {
            var fresh = await Activity.GetSinceAsync(_lastSeenId);
            if (fresh.Count == 0) return;

            // The API returns newest-first; prepend so the newest ends up on top of the list.
            Merge(fresh);
        }
        catch (ApiUnauthorizedException)
        {
            // Session died (token expired, or the account was disabled) — re-auth.
            Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            // Backend hiccup. The bell is not worth breaking the page over; try again next tick.
        }
    }

    private void Toggle()
    {
        _open = !_open;
        if (_open) _unseen = 0;
    }

    private void Close() => _open = false;

    private static string ActionIcon(string action) => action switch
    {
        "Create" => "plus",
        "Update" => "pencil",
        "Delete" => "trash",
        "Login" => "login",
        "LoginFailed" => "alert",
        _ => "check",
    };

    /// <summary>Colour carries the KIND of action, never the person who did it.</summary>
    private static string ActionStyle(string action) => action switch
    {
        "Create" => "bg-green-tint text-on-tint",
        "Update" => "bg-warn-tint text-warn",
        "Delete" or "LoginFailed" => "bg-danger-tint text-danger",
        _ => "bg-page text-ink-2",
    };

    private static string ActionText(string action) => action switch
    {
        "Create" => "زیادیکرد",
        "Update" => "دەستکاریی کرد",
        "Delete" => "سڕییەوە",
        "Login" => "چووە ژوورەوە",
        "LoginFailed" => "هەوڵی سەرنەکەوتووی چوونەژوورەوە",
        "CreateUser" => "بەکارهێنەرێکی زیادکرد",
        "UpdateUser" => "بەکارهێنەرێکی دەستکاری کرد",
        "DeleteUser" => "بەکارهێنەرێکی سڕییەوە",
        _ => action,
    };

    private static string EntityLabel(string entityType) => entityType switch
    {
        "Word" => "وشەیەک",
        "Category" => "پۆلێک",
        "WordMeans" => "واتایەک",
        "RelatedWord" => "پەیوەندییەک",
        "User" => "بەکارهێنەرێک",
        _ => entityType,
    };

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;

        if (span.TotalSeconds < 60) return "ئێستا";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} خولەک لەمەوپێش";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} کاتژمێر لەمەوپێش";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays} ڕۆژ لەمەوپێش";
        return utc.ToLocalTime().ToString("yyyy-MM-dd");
    }

    public ValueTask DisposeAsync()
    {
        Stream.Received -= OnActivityAsync;
        Stream.Reconnected -= OnReconnectedAsync;
        return ValueTask.CompletedTask;
    }
}

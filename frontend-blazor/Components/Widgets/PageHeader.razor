@* The top of every page: title, subtitle, and up to two actions on the opposite side.
   Actions belong here and nowhere else — a button floating above a card is how the old
   admin ended up with six different button styles. *@

<div class="mb-5 flex flex-wrap items-start gap-3">
    <div class="min-w-0">
        <h1 class="text-28 font-medium text-ink-1">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="mt-1 text-sm text-ink-2">@Subtitle</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="ms-auto flex flex-wrap items-center gap-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Pill buttons: one .btn-primary and at most one .btn-secondary.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}

@inject WordService WordSvc
@inject TaxonomyAdminService Taxonomy
@inject Toast Toast

@* The word editor.

   The order on screen is the order the work is actually done in:

     1. the word
     2. بەشی ئاخاوتن — ONE answer for the whole word
     3. تەوەر → نرخ — the axes that part of speech asks for, and an answer to each
     4. تێبینی — a note about the word
     5. واتاکان — the meanings, each just a text and a location

   The classification belongs to the WORD, not to each meaning. «ئاتون» is a ناو and it is
   بێلایەن, and those facts do not change between its three meanings; asking on every meaning
   invited three different answers to a question that has one. The database still stores the
   answer per sense — that is what the station and the work queue read — so the one answer here
   is written onto every sense the word has.

   Axes that do not apply are ABSENT, never disabled. A greyed-out control invites "why can't I
   set this", and the honest answer — that question is not asked of this word — is better said by
   the control not being there.

   Everything is Telerik: dialog, dropdowns, multiselect, textboxes, buttons. *@

@* VisibleChanged is not optional here. Visible is passed one-way from the parent, so when
   Telerik's own X sets its internal flag the parent never hears about it — the dialog closes
   itself, IsVisible stays true, and it will not reopen because nothing changed. Routing the
   change back through OnClose makes the X, the پاشگەزبوونەوە button and Esc all do one thing. *@
<TelerikDialog @ref="_dialog"
               Visible="@IsVisible" VisibleChanged="@OnVisibleChanged" Width="820px"
               Title="@(EditingWord is null ? "وشەی نوێ" : $"دەستکاری {EditingWord.Kurdish}")"
               ButtonsLayout="@DialogButtonsLayout.End">
    <DialogContent>
        <div class="max-h-[68vh] space-y-5 overflow-y-auto pe-1 text-start">

            @* ── 1. The word ─────────────────────────────────────────────── *@
            <div class="grid gap-4 md:grid-cols-2">
                <label class="block">
                    <span class="field-label">وشە <span class="text-danger">*</span></span>
                    <TelerikTextBox @bind-Value="Kurdish" Width="100%" Placeholder="وشەکە بنووسە" />
                    @if (MissingKurdish)
                    {
                        <span class="field-error">وشە پێویستە</span>
                    }
                </label>

                @* بەشی فەرهەنگ — required, and asked immediately after the headword because that
                   is the order the work is done in: you write the word, then you say which
                   section of the dictionary it belongs to.

                   AllowCustom, so a field nobody has entered yet can be typed here instead of
                   sending the lexicographer away to configure something and come back — which is
                   how words end up filed under whatever heading was already on the list. *@
                <label class="block">
                    <span class="field-label">بەشی فەرهەنگ <span class="text-danger">*</span></span>
                    <TelerikComboBox Data="@_sections" Value="@SectionName"
                                     ValueChanged="@((string v) => OnSectionChanged(v))"
                                     ValueExpression="@(() => SectionName)"
                                     TextField="@nameof(DictionarySectionDto.NameKu)"
                                     ValueField="@nameof(DictionarySectionDto.NameKu)"
                                     AllowCustom="true" Filterable="true" ClearButton="true"
                                     Placeholder="بەشی فەرهەنگ هەڵبژێرە یان بنووسە…" Width="100%" />
                    @if (MissingSection)
                    {
                        <span class="field-error">بەشی فەرهەنگ پێویستە</span>
                    }
                </label>

                @* Optional, and always has been — nothing on either side of the wire rejects a
                   word without one. It did not SAY so, which is a different problem and the one
                   people actually hit: an unmarked field beside a starred one reads as required,
                   so words waited on a پۆل nobody needed to choose. *@
                <label class="block">
                    <span class="field-label">
                        پۆلەکان
                        <span class="text-ink-3">— ئارەزوومەندانە</span>
                    </span>
                    <TelerikMultiSelect Data="@_allCategories" @bind-Value="SelectedCategoryIds"
                                        TextField="@nameof(CategoryDto.Name)" ValueField="@nameof(CategoryDto.Id)"
                                        Filterable="true" Placeholder="پۆل هەڵبژێرە…" Width="100%" />

                    @if (Classification.PartOfSpeechId is not null && SelectedCategoryIds.Count == 0)
                    {
                        @* Said out loud rather than left implicit, because the consequence is real
                           and belongs with the decision: the word saves, and the dashboard counts
                           it unfinished until somebody adds a پۆل. *@
                        <span class="mt-1 block text-11 text-ink-3">
                            بەشی ئاخاوتن دیاریکراوە — پۆل پێویست نییە. وشەکە پاشەکەوت دەبێت،
                            بەڵام تا پۆلێکی نەبێت وەک تەواونەکراو دەژمێردرێت.
                        </span>
                    }
                </label>
            </div>

            @* ── 2 & 3. بەشی ئاخاوتن → تەوەر → نرخ ───────────────────────── *@
            <div class="rounded-card border border-line bg-page p-4">
                <div class="mb-3 flex items-center gap-2.5">
                    <span class="card-badge !h-7 !w-7"><Icon Name="tag" Class="h-3.5 w-3.5" /></span>
                    <span class="card-title">پۆلێنی ڕێزمانی</span>
                    @if (Classification.PartOfSpeechId is not null)
                    {
                        <span class="pill pill-ok ms-auto">
                            <bdi>@Ku.N(AnsweredCount)</bdi> / <bdi>@Ku.N(_axes.Count)</bdi> پرسیار
                        </span>
                    }
                </div>

                <label class="block md:w-1/2">
                    <span class="field-label">بەشی ئاخاوتن</span>
                    <TelerikDropDownList Data="@_partsOfSpeech" Value="@Classification.PartOfSpeechId"
                                         ValueChanged="@((int? v) => OnPartOfSpeechChanged(v))"
                                         ValueExpression="@(() => Classification.PartOfSpeechId)"
                                         TextField="@nameof(TaxonomyPartOfSpeechDto.NameKu)"
                                         ValueField="@nameof(TaxonomyPartOfSpeechDto.Id)"
                                         DefaultText="هێشتا دیاری نەکراوە" Width="100%" />
                </label>

                @if (Classification.PartOfSpeechId is null)
                {
                    <p class="mt-3 rounded-chip border border-line-soft bg-card px-3 py-2 text-11 text-ink-3">
                        سەرەتا بەشی ئاخاوتن هەڵبژێرە تا پرسیارەکانی دەربکەون
                    </p>
                }
                else if (_resolving)
                {
                    <div class="mt-3 space-y-2">
                        <div class="skeleton h-9 rounded-chip"></div>
                        <div class="skeleton h-9 w-2/3 rounded-chip"></div>
                    </div>
                }
                else if (_axes.Count == 0)
                {
                    <p class="mt-3 rounded-chip border border-line-soft bg-card px-3 py-2 text-11 text-ink-3">
                        هیچ پرسیارێک بۆ ئەم بەشە ڕێکنەخراوە — لە ڕێکخستن زیادی بکە
                    </p>
                }
                else
                {
                    @* ONE dropdown per applicable question, rendered by the SAME component the
                       station uses — so the question wording, the empty «— هەڵبژێرە —» first entry,
                       the worked examples and the nesting are identical in both places by
                       construction rather than by two people remembering to keep them in step.

                       Deliberately NOT a two-column grid any more. The old grid put every axis of
                       the part of speech side by side, including the conditional ones, which is the
                       one shape this must never produce: under کار you saw جۆری کار and تێپەڕی at
                       once, and answering either had no effect on the other. A child question now
                       appears beneath the answer that opens it, indented, labelled with that
                       answer — and only then. *@
                    <div class="mt-3 space-y-3">
                        @foreach (var axis in _axes)
                        {
                            <AxisField Axis="axis" ShowName="true" OnPick="OnAxisPick" />
                        }
                    </div>

                    <p class="mt-3 text-11 leading-relaxed text-ink-3">
                        هیچ یەکێک لەمانە پێویست نییە — وشەکە بەبێ وەڵامیان پاشەکەوت دەبێت.
                    </p>
                }
            </div>

            @* ── 4. Note ─────────────────────────────────────────────────── *@
            <label class="block">
                <span class="field-label">تێبینی</span>
                <TelerikTextArea @bind-Value="Description" Width="100%" Rows="2"
                                 Placeholder="تێبینییەک دەربارەی وشەکە" />
            </label>

            @* ── 5. Meanings ─────────────────────────────────────────────── *@
            <div>
                <div class="mb-2 flex items-center gap-2.5">
                    <span class="card-badge !h-7 !w-7"><Icon Name="book" Class="h-3.5 w-3.5" /></span>
                    <span class="card-title">واتاکان</span>
                    <span class="pill @(Meanings.Count > 0 ? "pill-ok" : "pill-muted")">
                        <bdi>@Ku.N(Meanings.Count)</bdi>
                    </span>
                    <TelerikButton OnClick="@AddMeaning" Icon="@SvgIcon.Plus"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   Class="ms-auto">
                        واتای نوێ
                    </TelerikButton>
                </div>

                @if (Meanings.Count == 0)
                {
                    <div class="rounded-card border border-dashed border-line p-6 text-center">
                        <p class="text-sm text-ink-1">هێشتا هیچ واتایەک نییە</p>
                    </div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var meaning in Meanings)
                        {
                            <div class="flex flex-col gap-2 rounded-chip border border-line-soft bg-page p-2.5 sm:flex-row sm:items-start">
                                <div class="min-w-0 flex-1">
                                    <TelerikTextBox @bind-Value="meaning.Meaning" Width="100%"
                                                    Placeholder="واتا" />
                                </div>

                                <div class="w-full sm:w-52">
                                    @* Free-typed AND picked. The list is everything that has been
                                       used before — the eight built-in labels, everything already in
                                       the database, and anything typed in this form since it opened
                                       — because a closed vocabulary would block a language nobody
                                       has entered yet, and a list that forgets what you typed a
                                       moment ago makes you retype it on the next row. *@
                                    <TelerikComboBox Data="@LocateOptions"
                                                     Value="@meaning.Locate"
                                                     ValueChanged="@((string v) => SetLocate(meaning, v))"
                                                     ValueExpression="@(() => meaning.Locate)"
                                                     AllowCustom="true" Filterable="true"
                                                     ClearButton="true"
                                                     Placeholder="شوێن" Width="100%" />
                                </div>

                                <TelerikButton OnClick="@(() => RemoveMeaning(meaning))"
                                               Icon="@SvgIcon.Trash"
                                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                               Title="لابردن" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </DialogContent>

    <DialogButtons>
        <TelerikButton OnClick="@OnClose" Enabled="@(!_saving)">پاشگەزبوونەوە</TelerikButton>
        <TelerikButton OnClick="@HandleSave" Enabled="@(!_saving)"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">
            @(_saving ? "پاشەکەوت دەکرێت…" : "پاشەکەوتکردن")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public WordDto? EditingWord { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    string Kurdish = "";
    string Description = "";

    List<int> SelectedCategoryIds = new();
    List<CategoryDto> _allCategories = new();

    // ── بەشی فەرهەنگ ────────────────────────────────────────────────────────
    List<DictionarySectionDto> _sections = new();

    /// <summary>
    /// The last section chosen, remembered ACROSS words for the lifetime of this circuit.
    ///
    /// Somebody entering fifty medical terms picks «فەرهەنگی زانستی پزیشکی» once, not fifty
    /// times. static so it survives the form being disposed and rebuilt between words; per
    /// circuit rather than per user because it is a convenience for the sitting, not a setting
    /// worth a row in the database.
    /// </summary>
    static string? _stickySection;

    string? SectionName;
    int? SectionId;

    bool MissingSection => string.IsNullOrWhiteSpace(SectionName) && _submitted;

    List<WordMeansDto> Meanings = new();

    /// <summary>One answer for the whole word.</summary>
    WordClassificationDto Classification = new();

    List<TaxonomyPartOfSpeechDto> _partsOfSpeech = new();

    /// <summary>
    /// The dialog itself, so its content can be forced to redraw.
    ///
    /// StateHasChanged on this component is not enough: the dialog renders DialogContent inside
    /// its OWN render tree, and it does not re-render that tree just because the parent did. So
    /// choosing a part of speech updated the model, the axis dropdowns were built — and the
    /// dialog kept showing the markup it had. Refresh() is Telerik's answer to exactly this.
    /// </summary>
    TelerikDialog? _dialog;

    bool _saving;
    bool _submitted;

    bool MissingKurdish => string.IsNullOrWhiteSpace(Kurdish) && _submitted;

    /// <summary>Which word is on screen, so reopening the same one does not refetch.</summary>
    int _loadedFor = -1;

    static readonly string[] BaseLocates =
    {
        "English", "Arabic", "Persian", "Turkish",
        "Kurdish Badini", "Kurdish Sorani", "Zazaki", "Gorani",
    };

    List<string> _dbLocates = new();

    List<string> LocateOptions =>
        BaseLocates
            .Concat(_dbLocates)
            .Concat(Meanings.Select(m => m.Locate ?? "").Where(l => l.Length > 0))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(l => l)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _allCategories = await WordSvc.GetCategoriesAsync();
            _dbLocates = await WordSvc.GetLocatesAsync();
            _sections = await WordSvc.GetDictionarySectionsAsync();

            var overview = await Taxonomy.GetOverviewAsync();
            _partsOfSpeech = overview?.PartsOfSpeech.Where(p => p.IsActive).ToList() ?? new();

            // The per-axis value lists that used to be prefetched here are gone with the flat grid.
            // Each resolved question now arrives WITH its options — one round trip that returns
            // exactly the questions being asked, instead of one per axis in the whole taxonomy
            // whether this part of speech asks it or not.
        }
        catch (Exception ex)
        {
            Toast.Error($"ڕێکخستنەکان نەهاتنەوە: {ex.Message}");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsVisible)
        {
            _loadedFor = -1;
            return;
        }

        var id = EditingWord?.Id ?? 0;
        if (_loadedFor == id) return;
        _loadedFor = id;

        _submitted = false;
        Kurdish = EditingWord?.Kurdish ?? "";
        Description = EditingWord?.Description ?? "";
        SelectedCategoryIds = EditingWord?.Categories.Select(c => c.Id).ToList() ?? new();

        // An existing word shows its own section. A NEW word inherits the last one chosen —
        // never blank, which is the whole point: the section is the same for a run of words and
        // clearing it every time makes it the most repeated keystroke in the form.
        SectionId = EditingWord?.DictionarySectionId;
        SectionName = EditingWord?.DictionarySectionName ?? (EditingWord is null ? _stickySection : null);

        if (SectionName is not null && SectionId is null)
            SectionId = _sections.FirstOrDefault(x => x.NameKu == SectionName)?.Id;

        Meanings = EditingWord?.Meanings
            .Select(m => new WordMeansDto { Id = m.Id, Meaning = m.Meaning, Locate = m.Locate })
            .ToList() ?? new();

        Classification = new WordClassificationDto();
        _axes = new();

        if (EditingWord is null) return;

        try
        {
            Classification = await WordSvc.GetClassificationAsync(EditingWord.Id) ?? new();
        }
        catch (Exception ex)
        {
            Toast.Error($"پۆلێنی ڕێزمانی نەهاتەوە: {ex.Message}");
        }

        // Resolve against the answers this word already holds, so an existing کار opens with its
        // child questions already showing rather than needing the parent re-picked to reveal them.
        await ResolveAxesAsync();
    }

    // ── The cascade ─────────────────────────────────────────────────────────
    //
    // Resolved ON THE SERVER, by the same code the station and the settings preview run.
    //
    // This used to be a local filter: every axis assigned to the part of speech, rendered flat in a
    // two-column grid. It ignored RequiresValueId entirely, which meant a conditional question was
    // asked unconditionally — under کار you met جۆری کار and تێپەڕی side by side before answering
    // either, and a تێپەڕی answer could be saved against a ناتەواو verb where the question does not
    // apply. That is a second implementation of the entry form, and the moment there were two they
    // disagreed.
    //
    // The word being edited may not have a sense yet, so this cannot go through the sense-based
    // resolver. The settings-preview endpoint takes exactly what is available here — a part of speech
    // and a set of held values — and returns the visible axes depth-first, which is the same call the
    // preview pane makes.

    /// <summary>The questions that apply right now, depth-first. Never a full list of the part of speech's axes.</summary>
    List<StationAxisDto> _axes = new();

    bool _resolving;

    int AnsweredCount => _axes.Count(a => a.SelectedValueIds.Count > 0);

    IReadOnlyCollection<int> HeldValueIds =>
        Classification.Features.Where(f => f.ValueId is not null).Select(f => f.ValueId!.Value).ToList();

    /// <summary>
    /// Re-resolves the visible questions, then drops answers on questions that stopped being asked.
    ///
    /// The clearing is the half that matters. Changing جۆری کار from تەواو to ناتەواو hides تێپەڕی —
    /// and without this its answer would stay in the payload, invisible in a form that no longer shows
    /// the control, and get written to the sense on save. The server does the same thing on its own
    /// side (OptionsTreeService.ClearStaleAnswersAsync); doing it here too is what stops this dialog
    /// SENDING a stale answer in the first place.
    /// </summary>
    async Task ResolveAxesAsync()
    {
        if (Classification.PartOfSpeechId is not { } partOfSpeechId)
        {
            _axes = new();
            Classification.Features.Clear();
            return;
        }

        _resolving = true;
        Redraw();

        try
        {
            _axes = await Taxonomy.PreviewFormAsync(partOfSpeechId, HeldValueIds);
        }
        catch (Exception ex)
        {
            _axes = new();
            Toast.Error($"پرسیارەکان نەهاتنەوە: {ex.Message}");
        }
        finally
        {
            _resolving = false;
        }

        var visible = _axes.Select(a => a.AxisId).ToHashSet();
        Classification.Features.RemoveAll(f => !visible.Contains(f.AxisId));

        Redraw();
    }

    /// <summary>
    /// A pick in one of the questions. Single-choice replaces; a multi-choice question toggles up to
    /// its cap. Which one it is comes from the axis's own MaxSelections, never from a branch on a name.
    /// </summary>
    async Task OnAxisPick((int AxisId, int ValueId) pick)
    {
        var axis = _axes.FirstOrDefault(a => a.AxisId == pick.AxisId);
        if (axis is null) return;

        var held = Classification.Features.Where(f => f.AxisId == pick.AxisId).ToList();
        var already = held.FirstOrDefault(f => f.ValueId == pick.ValueId);

        if (axis.MaxSelections == 1)
        {
            // Re-picking the value already held is how AxisField clears a single-choice dropdown.
            Classification.Features.RemoveAll(f => f.AxisId == pick.AxisId);

            if (already is null)
                Classification.Features.Add(new SenseFeatureDto { AxisId = pick.AxisId, ValueId = pick.ValueId });
        }
        else if (already is not null)
        {
            Classification.Features.Remove(already);
        }
        else
        {
            if (axis.MaxSelections is { } cap && held.Count >= cap)
            {
                Toast.Error($"لەم پرسیارەدا تەنها {Ku.N(cap)} بژاردە دەکرێت هەڵبژێردرێت.");
                return;
            }

            Classification.Features.Add(new SenseFeatureDto { AxisId = pick.AxisId, ValueId = pick.ValueId });
        }

        await ResolveAxesAsync();
    }

    /// <summary>
    /// Changing the part of speech drops every answer that belonged to the old one.
    ///
    /// Not tidiness: ڕەگەز is a question about a ناو. Reclassify the word as a کردار and that
    /// answer stops being about anything — but it would stay in the row, invisible in a form
    /// that no longer shows the axis, and still counted by the work queue.
    ///
    /// Cleared before re-resolving rather than filtered after: the new part of speech may share an
    /// axis with the old one, and keeping that answer would silently carry a judgement about the word
    /// as a ناو over to the word as a کار.
    /// </summary>
    async Task OnPartOfSpeechChanged(int? partOfSpeechId)
    {
        Classification.PartOfSpeechId = partOfSpeechId;
        Classification.Features.Clear();

        await ResolveAxesAsync();
    }

    /// <summary>
    /// The dialog was dismissed by something other than our own buttons — the X, Esc, or the
    /// overlay. Only react to it CLOSING: Telerik also raises this on open, and calling OnClose
    /// there would shut the dialog the moment it appeared.
    /// </summary>
    async Task OnVisibleChanged(bool visible)
    {
        if (!visible) await OnClose.InvokeAsync();
    }

    /// <summary>
    /// Records the chosen section. A name that is not in the list yet stays as text until save,
    /// where it is created — so typing a new section never blocks on a round trip, and a section
    /// is never created for a word the user then abandons.
    /// </summary>
    void OnSectionChanged(string? name)
    {
        SectionName = string.IsNullOrWhiteSpace(name) ? null : name.Trim();
        SectionId = SectionName is null
            ? null
            : _sections.FirstOrDefault(x => x.NameKu == SectionName)?.Id;

        Redraw();
    }

    void AddMeaning()
    {
        Meanings.Add(new WordMeansDto());
        Redraw();
    }

    void RemoveMeaning(WordMeansDto meaning)
    {
        Meanings.Remove(meaning);
        Redraw();
    }

    /// <summary>
    /// Re-render this component AND the dialog's own content tree. Both are needed: the first
    /// rebuilds the fragment, the second makes the dialog actually draw it.
    /// </summary>
    void Redraw()
    {
        StateHasChanged();
        _dialog?.Refresh();
    }

    /// <summary>
    /// Records a location and makes it available to every other row immediately.
    ///
    /// LocateOptions already reads the current meanings, but only re-evaluates when something
    /// re-renders — so a label typed into row one would not appear in row two's list until some
    /// unrelated interaction happened to refresh the form. Adding it to the known set and
    /// rendering here is what makes "type it once" true.
    /// </summary>
    void SetLocate(WordMeansDto meaning, string? value)
    {
        meaning.Locate = string.IsNullOrWhiteSpace(value) ? null : value.Trim();

        if (meaning.Locate is { } locate &&
            !LocateOptions.Contains(locate, StringComparer.OrdinalIgnoreCase))
        {
            _dbLocates.Add(locate);
        }

        Redraw();
    }

    // ── Save ────────────────────────────────────────────────────────────────

    async Task HandleSave()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(Kurdish)) return;

        // Required. Enforced here rather than only by a red label, because the label is easy to
        // scroll past and a word filed under no section is invisible to every section filter.
        if (string.IsNullOrWhiteSpace(SectionName))
        {
            Toast.Error("بەشی فەرهەنگ پێویستە");
            return;
        }

        _saving = true;

        try
        {
            // Blank rows are dropped rather than rejected: adding one and changing your mind
            // should not mean hunting for it before the form will save.
            var meanings = Meanings
                .Where(m => !string.IsNullOrWhiteSpace(m.Meaning))
                .Select(m => new WordMeansDto { Meaning = m.Meaning.Trim(), Locate = m.Locate })
                .ToList();

            // Typed rather than picked: create it now, once the word is definitely being saved.
            if (SectionId is null)
            {
                var created = await WordSvc.CreateDictionarySectionAsync(SectionName);
                if (created is null)
                {
                    Toast.Error("بەشی فەرهەنگ دروست نەکرا");
                    return;
                }

                SectionId = created.Id;

                // Available to the next word without reopening the form.
                if (_sections.All(x => x.Id != created.Id)) _sections.Add(created);
            }

            _stickySection = SectionName;

            int wordId;

            if (EditingWord is null)
            {
                var created = await WordSvc.CreateWordAsync(new CreateWordDto
                {
                    Kurdish = Kurdish.Trim(),
                    DictionarySectionId = SectionId,
                    CategoryIds = SelectedCategoryIds,
                    Description = NullIfEmpty(Description),
                    Meanings = meanings,
                    RelatedWords = new(),
                });

                if (created is null)
                {
                    Toast.Error("وشەکە دروست نەکرا");
                    return;
                }

                wordId = created.Id;
            }
            else
            {
                // Relations are edited on their own page; resend them unchanged, or this update
                // reads to the server as "this word now has none".
                var relations = EditingWord.OutgoingRelations.Select(r => new CreateRelatedWordDto
                {
                    TargetWordId = r.RelatedWordId,
                    RelationType = r.RelationType,
                    Weight = r.Weight,
                }).ToList();

                await WordSvc.UpdateWordAsync(EditingWord.Id, new UpdateWordDto
                {
                    Kurdish = Kurdish.Trim(),
                    DictionarySectionId = SectionId,
                    SpeechPanes = EditingWord.SpeechPanes.Select(sp => sp.Id).ToList(),
                    CategoryIds = SelectedCategoryIds,
                    Gender = EditingWord.Gender,
                    Description = NullIfEmpty(Description),
                    Meanings = meanings,
                    RelatedWords = relations,
                });

                wordId = EditingWord.Id;
            }

            await WordSvc.SaveClassificationAsync(wordId, Classification);

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"پاشەکەوتکردن سەرکەوتوو نەبوو: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    static string? NullIfEmpty(string s) =>
        string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
